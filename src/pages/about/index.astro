---
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import abdenourPortrait from '../../assets/portrait/abdenour.jpg';
import Button from '../../components/ui/Button.astro';

const toolsAndSetup = [
  {
    category: 'Hardware & Workstation',
    items: [
      'Apple Silicon Mac (M-Series) for primary engineering',
      'Dual high-resolution displays calibrated for typography and code',
      'Custom mechanical keyboard with tactile switches',
      'Shure MV7 microphone for BenCoder video tutorial audio',
    ],
  },
  {
    category: 'Software & Environment',
    items: [
      'VS Code and Neovim configured with strict TypeScript and Python linting',
      'Ghostty and iTerm2 with zsh, tmux, and custom dotfiles',
      'Docker for local database containers and microservice testing',
      'TablePlus for PostgreSQL inspection and schema queries',
    ],
  },
  {
    category: 'AI & Machine Learning Toolchain',
    items: [
      'Hugging Face Transformers and Datasets for local tokenization',
      'PyTorch with MPS / CUDA acceleration for fine-tuning loops',
      'ChromaDB and pgvector for local vector similarity benchmarking',
      'Ollama for local LLM inference testing and privacy-first prototyping',
    ],
  },
];
---

<Base
  title="About & Engineering Philosophy — Abdenour Benkorich"
  description="Learn about Abdenour Benkorich (BenCoder): background, journey into artificial intelligence, software engineering philosophy, and workstation setup."
>
  <main id="main" class="py-16 sm:py-24 space-y-20">
    <div class="max-w-5xl mx-auto px-6 sm:px-8 md:px-12 space-y-16">
      <!-- Breadcrumb navigation -->
      <nav class="flex items-center gap-2 text-small text-text-muted" aria-label="Breadcrumb">
        <a href="/" class="hover:text-text transition-colors">Home</a>
        <span>/</span>
        <span class="text-text font-semibold">About</span>
      </nav>

      <!-- Header -->
      <div class="space-y-4 pb-6">
        <h1 class="text-display text-text">
          Engineering with Rigor, Teaching with Clarity
        </h1>
        <p class="text-lead text-text-muted max-prose">
          The backstory, technical convictions, and daily workstation of an AI instructor,
          full-stack engineer, and developer educator based in Mostaganem, Algeria.
        </p>
      </div>

      <!-- Section: Portrait & Long-Form Bio -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-start">
        <!-- Natural Color Portrait -->
        <div class="md:col-span-5 space-y-4">
          <div class="aspect-4/5 rounded-lg overflow-hidden bg-surface-2">
            <Image
              src={abdenourPortrait}
              alt="Abdenour Benkorich"
              class="w-full h-full object-cover"
              style="object-position: 42% 28%;"
              width={800}
              height={1000}
            />
          </div>
          <div class="space-y-1 text-small text-text-muted">
            <div class="font-semibold text-text">Abdenour Benkorich (BenCoder)</div>
            <div>State Engineering Degree (PFE 2026) · Universite Abdelhamid Ibn Badis</div>
            <div>Mostaganem, Algeria (UTC+1)</div>
          </div>
        </div>

        <!-- Long-Form Bio -->
        <div class="md:col-span-7 space-y-6 text-body text-text-muted leading-relaxed max-prose">
          <p class="text-xl font-medium text-text leading-relaxed">
            I am a software engineer, AI instructor, and content creator. I combine algorithmic discipline with full-stack craftsmanship to build software that performs under real-world constraints.
          </p>

          <p>
            My journey began with low-level systems programming and microcontroller robotics with Arduino and ESP32 at DZDuino Labs. That hands-on hardware foundation taught me to appreciate memory constraints, sensor latency, and determinism. When I transitioned into machine learning and distributed web engineering, that physical-world mindset persisted: software must be observable, resilient, and fast.
          </p>

          <p>
            In 2022, I founded <strong class="text-text font-semibold">BenCoder</strong> to address a critical gap: high-caliber computer science and applied AI education taught natively in Arabic without superficial shortcuts. Today, the platform connects over <strong class="text-text font-semibold">102,000 developers</strong> across Algeria and the Arab world.
          </p>

          <p>
            At <strong class="text-text font-semibold">Everest Academy</strong>, I serve as Lead AI Instructor heading the "Build with AI" intensive formation. I mentor engineers on moving from basic prompt usage to architecting real generative systems, vibe coding workflows, and production deployments.
          </p>

          <div class="pt-4 flex flex-wrap gap-4">
            <Button href="/work" variant="primary" size="md">
              Explore Projects
            </Button>
            <Button href="/Abdenour_Benkorich_CV.pdf" variant="secondary" size="md" target="_blank" rel="noopener noreferrer">
              Download CV (PDF)
            </Button>
          </div>
        </div>
      </div>

      <!-- Section: Workstation & Tooling -->
      <section class="space-y-8 pt-8">
        <div class="space-y-2">
          <h2 class="text-headline text-text">Workstation & Environment</h2>
          <p class="text-body text-text-muted max-prose">
            The hardware and software tooling behind my daily engineering and educational productions.
          </p>
        </div>

        <div class="space-y-6">
          {
            toolsAndSetup.map((sec) => (
              <div class="bg-surface rounded-lg p-6 sm:p-8 space-y-3">
                <h3 class="text-xl font-bold text-text">{sec.category}</h3>
                <ul class="space-y-2 text-small text-text-muted list-disc pl-4">
                  {sec.items.map((item) => (
                    <li class="leading-relaxed">{item}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </main>
</Base>
