---
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/projects';
import Button from '../../components/ui/Button.astro';
---

<Base
  title="Selected Work & Case Studies — Abdenour Benkorich"
  description="Explore production AI models, full-stack web platforms, client solutions, and open-source tooling built and shipped by Abdenour Benkorich."
>
  <main id="main" class="py-16 sm:py-24 space-y-16">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 md:px-12 space-y-16">
      <!-- Page Header -->
      <div class="space-y-4 pb-4">
        <!-- Breadcrumb back link -->
        <nav class="flex items-center gap-2 text-small text-text-muted" aria-label="Breadcrumb">
          <a href="/" class="hover:text-text transition-colors">Home</a>
          <span>/</span>
          <span class="text-text font-semibold">Work</span>
        </nav>

        <h1 class="text-display text-text">
          Selected Work & Case Studies
        </h1>
        <p class="text-lead text-text-muted max-prose">
          From resilient botanical intelligence platforms and digital manufacturing consoles to B2B
          procurement networks and top-rated engineering courses. Every project built with strict
          performance budgets and production reliability.
        </p>
      </div>

      <!-- Projects Catalog Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-stretch">
        {
          projects.map((project) => (
            <article class="bg-surface rounded-lg p-6 sm:p-8 flex flex-col justify-between space-y-6">
              <div class="space-y-5">
                <!-- Project Preview Image -->
                <a
                  href={`/work/${project.slug}`}
                  class="block rounded-lg overflow-hidden aspect-16/10 bg-surface-2 group"
                >
                  <img
                    src={project.image}
                    alt={project.title}
                    class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                    loading="lazy"
                    width="800"
                    height="500"
                  />
                </a>

                <!-- Title & Summary -->
                <div class="space-y-2">
                  <h2 class="text-2xl font-bold text-text tracking-tight hover:underline">
                    <a href={`/work/${project.slug}`}>{project.title}</a>
                  </h2>

                  <!-- Meta Line -->
                  <div class="flex items-center justify-between text-small text-text-muted">
                    <span>{project.year}</span>
                    <span class="text-text font-medium">{project.role}</span>
                  </div>

                  <p class="text-body text-text-muted leading-relaxed">
                    {project.summary}
                  </p>
                </div>

                <!-- Tech Stack Tags -->
                <div class="flex flex-wrap gap-1.5 pt-1">
                  {project.stack.slice(0, 5).map((tech) => (
                    <span class="text-small px-2.5 py-1 rounded bg-surface-2 text-text font-medium">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Action Link -->
              <div class="pt-4 flex items-center justify-between">
                <Button href={`/work/${project.slug}`} variant="primary" size="md">
                  Read Case Study
                </Button>
                {project.liveUrl && (
                  <Button href={project.liveUrl} variant="ghost" size="md" target="_blank" rel="noopener noreferrer">
                    Live Site
                  </Button>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </main>
</Base>
