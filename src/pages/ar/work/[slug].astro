---
import Base from '../../../layouts/Base.astro';
import { projects as rawProjects, type Project } from '../../../data/projects';
import { getLocalizedProject } from '../../../i18n/projects.ar';
import TagList from '../../../components/ui/TagList.astro';
import Button from '../../../components/ui/Button.astro';
import Reveal from '../../../components/ui/Reveal.astro';

export async function getStaticPaths() {
  return rawProjects.map((project) => ({
    params: { slug: project.slug },
    props: { rawProject: project },
  }));
}

interface Props {
  rawProject: Project;
}

const { rawProject } = Astro.props;
const project = getLocalizedProject(rawProject, 'ar');

// Find next project for footer navigation
const currentIndex = rawProjects.findIndex((p) => p.slug === rawProject.slug);
const nextRawProject = rawProjects[(currentIndex + 1) % rawProjects.length];
const nextProject = getLocalizedProject(nextRawProject, 'ar');
---

<Base
  locale="ar"
  title={`${project.title} — دراسة حالة | عبد النور بن قريش`}
  description={project.summary}
>
  <main id="main" class="py-16 sm:py-24 space-y-16">
    <div class="max-w-[900px] mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
      <!-- Breadcrumb navigation -->
      <div class="flex items-center gap-2 text-xs font-mono text-text-muted">
        <a href="/ar" class="hover:text-text transition-colors">الرئيسية</a>
        <span>/</span>
        <a href="/ar/work" class="hover:text-text transition-colors">المشاريع</a>
        <span>/</span>
        <span class="text-text font-bold truncate">{project.title.split('—')[0].trim()}</span>
      </div>

      <!-- Case Study Hero Header -->
      <div class="space-y-6 border-b border-border pb-10">
        <div class="flex flex-wrap items-center gap-3 text-xs font-mono">
          <span class="px-2.5 py-1 rounded bg-surface-2 border border-border text-text font-bold">
            {project.category}
          </span>
          <span class="text-text-faint">·</span>
          <span class="text-text-muted">الدور: <strong class="text-text">{project.role}</strong></span>
          <span class="text-text-faint">·</span>
          <span class="text-text-faint bidi-tech">{project.year}</span>
          <span class="mr-auto text-xs font-mono text-status font-medium">
            {project.status === 'live' ? '● بيئة الإنتاج الحية' : '● مبادرة أساسية'}
          </span>
        </div>

        <h1 class="text-display text-text font-sans">
          {project.title}
        </h1>

        <p class="text-lg sm:text-xl text-text-muted leading-relaxed font-sans">
          {project.summary}
        </p>

        <!-- Live Links and Repository -->
        <div class="flex flex-wrap items-center gap-4 pt-2">
          {project.liveUrl && (
            <Button href={project.liveUrl} variant="primary" size="md">
              زيارة المنصة الحية ↗
            </Button>
          )}
          {project.repoUrl && (
            <Button href={project.repoUrl} variant="secondary" size="md">
              المستودع البرمجي على GitHub ↗
            </Button>
          )}
          <Button href="/ar#contact" variant="ghost" size="md">
            استفسار حول هذه المعمارية ←
          </Button>
        </div>
      </div>

      <!-- High-Fidelity Platform Architecture Screenshot -->
      <Reveal delay={60}>
        <div class="rounded-2xl overflow-hidden border border-border-strong bg-surface shadow-md">
          <div class="flex items-center justify-between px-4 py-2.5 border-b border-border bg-surface-2 text-xs font-mono text-text-faint">
            <div class="flex items-center gap-2" aria-hidden="true">
              <span class="w-3 h-3 rounded-full bg-border-strong"></span>
              <span class="w-3 h-3 rounded-full bg-border-strong"></span>
              <span class="w-3 h-3 rounded-full bg-border-strong"></span>
            </div>
            <span class="text-xs text-text-muted font-mono bidi-tech">{project.liveUrl ? project.liveUrl.replace('https://', '') : `${project.slug}.internal/telemetry`}</span>
            <span class="text-status text-xs font-medium">{project.status === 'live' ? '● بيئة الإنتاج الحية' : '● أبحاث جارية'}</span>
          </div>
          <div class="aspect-[16/9] w-full overflow-hidden bg-surface-2">
            <img
              src={project.image}
              alt={`${project.title} لقطة شاشة`}
              class="w-full h-full object-cover object-top"
              loading="eager"
              width="1280"
              height="720"
            />
          </div>
        </div>
      </Reveal>

      <!-- Key Metrics Strip -->
      {project.metrics && project.metrics.length > 0 && (
        <Reveal delay={100}>
          <div class="grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x rtl:divide-x-reverse divide-border border border-border rounded-xl bg-surface/60 overflow-hidden font-mono">
            {project.metrics.map((m) => (
              <div class="p-5 space-y-1">
                <div class="text-[10px] uppercase tracking-wider text-text-faint">
                  {m.label}
                </div>
                <div class="text-2xl font-bold text-text font-sans tracking-tight bidi-tech">
                  {m.value}
                </div>
              </div>
            ))}
          </div>
        </Reveal>
      )}

      <!-- Detailed Case Study Narrative -->
      <article class="space-y-12 text-text">
        <!-- Overview & Full Description -->
        {project.fullDescription && (
          <Reveal delay={120}>
            <section class="space-y-4">
              <h2 class="text-2xl font-bold tracking-tight text-text font-sans border-b border-border pb-3">
                01 // السياق والهدف من المشروع
              </h2>
              <p class="text-base sm:text-lg text-text-muted leading-relaxed">
                {project.fullDescription}
              </p>
            </section>
          </Reveal>
        )}

        <!-- The Engineering Challenge -->
        {project.challenge && (
          <Reveal delay={160}>
            <section class="space-y-4">
              <h2 class="text-2xl font-bold tracking-tight text-text font-sans border-b border-border pb-3">
                02 // التحدي الهندسي التقني
              </h2>
              <div class="p-6 rounded-xl border border-border bg-surface-2/60 space-y-2">
                <p class="text-base text-text-muted leading-relaxed">
                  {project.challenge}
                </p>
              </div>
            </section>
          </Reveal>
        )}

        <!-- Architectural Solution -->
        {project.solution && (
          <Reveal delay={200}>
            <section class="space-y-4">
              <h2 class="text-2xl font-bold tracking-tight text-text font-sans border-b border-border pb-3">
                03 // المعمارية البرمجية وحلول التنفيذ
              </h2>
              <p class="text-base sm:text-lg text-text-muted leading-relaxed">
                {project.solution}
              </p>

              <!-- Deliverable Bullet Highlights -->
              <div class="p-6 rounded-xl border border-border bg-surface space-y-3 font-mono text-xs">
                <div class="text-[11px] text-text-faint uppercase tracking-wider font-bold">
                  المخرجات والحلول التقنية المنجزة:
                </div>
                <ul class="space-y-2 text-text-muted">
                  {project.bullets.map((b) => (
                    <li class="flex items-start gap-2.5">
                      <span class="text-status font-bold select-none">✓</span>
                      <span class="leading-relaxed font-sans text-sm">{b}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </section>
          </Reveal>
        )}

        <!-- Architectural Decisions & Engineering Trade-Offs -->
        {project.architecturalDecisions && project.architecturalDecisions.length > 0 && (
          <Reveal delay={210}>
            <section class="space-y-6">
              <div class="border-b border-border pb-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <h2 class="text-2xl font-bold tracking-tight text-text font-sans">
                  04 // القرارات المعمارية والموازنات الهندسية (Trade-Offs)
                </h2>
                <span class="text-xs font-mono text-text-faint">
                  المشكلة ← القرار المعماري ← الموازنة ← النتيجة المُحققة
                </span>
              </div>

              <div class="space-y-4">
                {project.architecturalDecisions.map((dec, dIdx) => (
                  <div class="p-5 sm:p-6 rounded-xl border border-border bg-surface-2/40 hover:bg-surface-2/70 transition-all space-y-4">
                    <div class="flex flex-wrap items-center gap-2 text-xs font-mono text-status font-semibold">
                      <span>القرار 0{dIdx + 1}</span>
                      <span class="text-text-faint">/</span>
                      <span class="text-text font-sans text-base font-bold">{dec.title}</span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5 text-xs font-mono">
                      <div class="p-3.5 rounded-lg border border-border bg-surface space-y-1">
                        <div class="text-[10px] uppercase tracking-wider text-text-faint font-bold">المشكلة المطروحة:</div>
                        <div class="text-text-muted leading-relaxed font-sans text-xs">{dec.problem}</div>
                      </div>

                      <div class="p-3.5 rounded-lg border border-border bg-surface space-y-1">
                        <div class="text-[10px] uppercase tracking-wider text-text-faint font-bold">القرار المعماري:</div>
                        <div class="text-text leading-relaxed font-sans text-xs">{dec.decision}</div>
                      </div>

                      <div class="p-3.5 rounded-lg border border-border bg-surface space-y-1">
                        <div class="text-[10px] uppercase tracking-wider text-text-faint font-bold">الموازنة الهندسية:</div>
                        <div class="text-text-muted leading-relaxed font-sans text-xs">{dec.tradeOff}</div>
                      </div>

                      <div class="p-3.5 rounded-lg border border-status/40 bg-status/5 space-y-1">
                        <div class="text-[10px] uppercase tracking-wider text-status font-bold">النتيجة المُحققة:</div>
                        <div class="text-text leading-relaxed font-sans text-xs font-medium">{dec.result}</div>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </section>
          </Reveal>
        )}

        <!-- Platform Screenshots & Visual Architecture Gallery -->
        {project.screenshots && project.screenshots.length > 0 && (
          <Reveal delay={220}>
            <section class="space-y-6">
              <h2 class="text-2xl font-bold tracking-tight text-text font-sans border-b border-border pb-3">
                {project.architecturalDecisions && project.architecturalDecisions.length > 0 ? '05' : '04'} // لقطات المنصة والقياسات الحية
              </h2>
              <div class="space-y-6">
                {project.screenshots.map((s, sIdx) => (
                  <div class="rounded-xl overflow-hidden border border-border-strong bg-surface shadow-sm">
                    <div class="flex items-center justify-between px-4 py-2 border-b border-border bg-surface-2 text-xs font-mono text-text-faint">
                      <div class="flex items-center gap-1.5" aria-hidden="true">
                        <span class="w-2.5 h-2.5 rounded-full bg-border-strong inline-block" />
                        <span class="w-2.5 h-2.5 rounded-full bg-border-strong inline-block" />
                        <span class="w-2.5 h-2.5 rounded-full bg-border-strong inline-block" />
                      </div>
                      <span class="text-text-muted text-[11px] font-mono truncate max-w-[280px]">
                        {s.caption || `لقطة ${sIdx + 1}`}
                      </span>
                      <span class="text-status text-[10px] font-bold">● التقاط حي</span>
                    </div>
                    <div class="w-full overflow-hidden bg-bg p-1 sm:p-2">
                      <img
                        src={s.url}
                        alt={s.caption || `${project.title} لقطة شاشة ${sIdx + 1}`}
                        class="w-full h-auto object-contain rounded-lg max-h-[750px] mx-auto border border-border/40"
                        loading="lazy"
                      />
                    </div>
                    {s.caption && (
                      <div class="px-4 py-2.5 bg-surface-2/60 border-t border-border text-xs font-mono text-text-muted flex items-center gap-2">
                        <span class="text-status font-bold">↳</span>
                        <span>{s.caption}</span>
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </section>
          </Reveal>
        )}

        <!-- Technology Stack Deep-Dive -->
        <Reveal delay={240}>
          <section class="space-y-4">
            <h2 class="text-2xl font-bold tracking-tight text-text font-sans border-b border-border pb-3">
              {project.architecturalDecisions && project.architecturalDecisions.length > 0 
                ? (project.screenshots && project.screenshots.length > 0 ? '06' : '05')
                : (project.screenshots && project.screenshots.length > 0 ? '05' : '04')} // الحزمة التقنية المستخدمة
            </h2>
            <div class="p-6 rounded-xl border border-border bg-surface-2/40 space-y-4">
              <p class="text-sm text-text-muted">
                تم اختيار كل تقنية وأداة بناءً على قيود أداء صارمة، وموثوقية عالية في بيئات الإنتاج، واستقرار الأنظمة على المدى الطويل.
              </p>
              <TagList size="md" tags={project.stack} />
            </div>
          </section>
        </Reveal>
      </article>

      <!-- Next Project & Return Strip -->
      <div class="border-t border-border pt-10 flex flex-col sm:flex-row items-center justify-between gap-6">
        <a
          href="/ar/work"
          class="text-xs font-mono text-text-muted hover:text-text inline-flex items-center gap-1.5 transition-colors"
        >
          → العودة إلى كافة المشاريع
        </a>

        <a
          href={`/ar/work/${nextProject.slug}`}
          class="p-4 rounded-xl border border-border bg-surface hover:border-text transition-all group flex items-center gap-4 text-right"
        >
          <div>
            <div class="text-[10px] font-mono uppercase tracking-wider text-text-faint">دراسة الحالة التالية</div>
            <div class="text-sm font-bold text-text group-hover:underline">{nextProject.title.split('—')[0]}</div>
          </div>
          <span class="text-lg text-text group-hover:-translate-x-1 transition-transform">←</span>
        </a>
      </div>
    </div>
  </main>
</Base>
