---
import Base from '../../../layouts/Base.astro';
import { projects, type Project } from '../../../data/projects';
import { getLocalizedProject } from '../../../i18n/projects.ar';
import Button from '../../../components/ui/Button.astro';

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project: getLocalizedProject(project, 'ar') },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;

const currentIndex = projects.findIndex((p) => p.slug === project.slug);
const nextRawProject = projects[(currentIndex + 1) % projects.length];
const nextProject = getLocalizedProject(nextRawProject, 'ar');
---

<Base
  title={`${project.title} — دراسة الحالة المعمارية | عبد النور بن قريش`}
  description={project.summary}
  locale="ar"
>
  <main id="main" class="py-16 sm:py-24 space-y-16">
    <div class="max-w-4xl mx-auto px-6 sm:px-8 md:px-12 space-y-14">
      <!-- Breadcrumb navigation -->
      <nav class="flex items-center gap-2 text-small text-text-muted" aria-label="Breadcrumb">
        <a href="/ar" class="hover:text-text transition-colors">الرئيسية</a>
        <span>/</span>
        <a href="/ar/work" class="hover:text-text transition-colors">المشاريع</a>
        <span>/</span>
        <span class="text-text font-semibold truncate">{project.title.split('—')[0].trim()}</span>
      </nav>

      <!-- Case Study Hero Header -->
      <div class="space-y-6 pb-6">
        <div class="flex flex-wrap items-center gap-3 text-small text-text-muted">
          <span class="text-text font-semibold">{project.year}</span>
          <span>·</span>
          <span>الدور: <strong class="text-text">{project.role}</strong></span>
          <span>·</span>
          <span class="text-status font-medium">
            {project.status === 'live' ? 'منصة حية في الإنتاج' : 'مبادرة بحثية نشطة'}
          </span>
        </div>

        <h1 class="text-display text-text">
          {project.title}
        </h1>

        <p class="text-lead text-text-muted leading-relaxed max-prose">
          {project.summary}
        </p>

        <!-- Action Links -->
        <div class="flex flex-wrap items-center gap-4 pt-2">
          {
            project.liveUrl && (
              <Button href={project.liveUrl} variant="primary" size="md" target="_blank" rel="noopener noreferrer">
                معاينة المنصة الحية
              </Button>
            )
          }
          {
            project.repoUrl && (
              <Button href={project.repoUrl} variant="secondary" size="md" target="_blank" rel="noopener noreferrer">
                مستودع الكود على GitHub
              </Button>
            )
          }
          <Button href="/ar#contact" variant="ghost" size="md">
            استفسار حول هذه المعمارية
          </Button>
        </div>
      </div>

      <!-- High-Fidelity Platform Architecture Screenshot -->
      <div class="rounded-lg overflow-hidden bg-surface-2 aspect-16/10">
        <img
          src={project.image}
          alt={`معمارية منصة ${project.title}`}
          class="w-full h-full object-cover object-top"
          loading="eager"
          width="1280"
          height="720"
        />
      </div>

      <!-- Key Metrics Strip -->
      {
        project.metrics && project.metrics.length > 0 && (
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 bg-surface rounded-lg p-6 sm:p-8">
            {project.metrics.map((m) => (
              <div class="space-y-1">
                <div class="text-small text-text-muted">{m.label}</div>
                <div class="text-2xl font-bold text-text tracking-tight">{m.value}</div>
              </div>
            ))}
          </div>
        )
      }

      <!-- Detailed Case Study Narrative -->
      <article class="space-y-12 text-text">
        <!-- Overview & Full Description -->
        {
          project.fullDescription && (
            <section class="space-y-4">
              <h2 class="text-headline text-text">
                السياق والهدف
              </h2>
              <p class="text-body text-text-muted leading-relaxed max-prose">
                {project.fullDescription}
              </p>
            </section>
          )
        }

        <!-- The Engineering Challenge -->
        {
          project.challenge && (
            <section class="space-y-4">
              <h2 class="text-headline text-text">
                التحدي الهندسي
              </h2>
              <div class="p-6 rounded-lg bg-surface space-y-2">
                <p class="text-body text-text-muted leading-relaxed max-prose">{project.challenge}</p>
              </div>
            </section>
          )
        }

        <!-- Architectural Solution -->
        {
          project.solution && (
            <section class="space-y-4">
              <h2 class="text-headline text-text">
                المعمارية والتنفيذ
              </h2>
              <p class="text-body text-text-muted leading-relaxed max-prose">
                {project.solution}
              </p>

              <!-- Deliverable Bullet Highlights -->
              <div class="p-6 rounded-lg bg-surface space-y-3">
                <div class="text-small font-semibold text-text uppercase">
                  أبرز الإنجازات التقنية:
                </div>
                <ul class="space-y-2 text-text-muted list-disc pr-4">
                  {project.bullets.map((b) => (
                    <li class="leading-relaxed text-small">{b}</li>
                  ))}
                </ul>
              </div>
            </section>
          )
        }

        <!-- Architectural Decisions -->
        {
          project.architecturalDecisions && project.architecturalDecisions.length > 0 && (
            <section class="space-y-6">
              <h2 class="text-headline text-text">
                القرارات المعمارية والموازنات الهندسية
              </h2>

              <div class="space-y-6">
                {project.architecturalDecisions.map((dec) => (
                  <div class="p-6 rounded-lg bg-surface space-y-4">
                    <h3 class="text-xl font-bold text-text">{dec.title}</h3>

                    <div class="space-y-3 text-small text-text-muted leading-relaxed">
                      <div>
                        <strong class="text-text font-semibold">المشكلة: </strong>
                        {dec.problem}
                      </div>
                      <div>
                        <strong class="text-text font-semibold">القرار: </strong>
                        {dec.decision}
                      </div>
                      <div>
                        <strong class="text-text font-semibold">الموازنة: </strong>
                        {dec.tradeOff}
                      </div>
                      <div>
                        <strong class="text-status font-semibold">النتيجة: </strong>
                        {dec.result}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </section>
          )
        }

        <!-- Technology Stack -->
        <section class="space-y-4 pt-4">
          <h2 class="text-headline text-text">
            الحزمة التقنية وبيئة التشغيل
          </h2>
          <div class="flex flex-wrap gap-2">
            {project.stack.map((tech) => (
              <span class="text-small px-3.5 py-1.5 rounded bg-surface text-text font-medium">
                {tech}
              </span>
            ))}
          </div>
        </section>
      </article>

      <!-- Next Project Navigation -->
      <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <a href="/ar/work" class="text-small text-text-muted hover:text-text transition-colors">
          العودة لكافة المشاريع
        </a>

        {nextProject && (
          <a
            href={`/ar/work/${nextProject.slug}`}
            class="text-small font-semibold text-text hover:text-text-muted transition-colors flex items-center gap-2"
          >
            <span>التالي: {nextProject.title.split('—')[0].trim()}</span>
          </a>
        )}
      </div>
    </div>
  </main>
</Base>
