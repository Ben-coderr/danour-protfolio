---
import Base from '../../../layouts/Base.astro';
import { projects as rawProjects } from '../../../data/projects';
import { getLocalizedProject } from '../../../i18n/projects.ar';
import TagList from '../../../components/ui/TagList.astro';
import Button from '../../../components/ui/Button.astro';
import SectionLabel from '../../../components/ui/SectionLabel.astro';
import Reveal from '../../../components/ui/Reveal.astro';

const projects = rawProjects.map((p) => getLocalizedProject(p, 'ar'));
---

<Base
  locale="ar"
  title="المشاريع الهندسية ودراسات الحالة — عبد النور بن قريش"
  description="استكشف نماذج الذكاء الاصطناعي في الإنتاج، منصات الويب المتكاملة، الحلول المؤسسية، والأدوات مفتوحة المصدر التي طورها وأطلقها عبد النور بن قريش."
>
  <main id="main" class="py-16 sm:py-24 space-y-16">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <!-- Page Header -->
      <div class="border-b border-border pb-10 space-y-4">
        <div class="flex items-center gap-2">
          <SectionLabel number="01" label="أرشيف المشاريع ودراسات الحالة" />
          <span class="text-xs font-mono text-text-faint">·</span>
          <span class="text-xs font-mono text-status font-medium">● 09 أنظمة مُطلقة</span>
        </div>
        <h1 class="text-display text-text">
          المشاريع الهندسية و <span class="font-accent">المعمارية البرمجية</span>
        </h1>
        <p class="text-base sm:text-lg text-text-muted max-w-2xl leading-relaxed">
          من أنظمة الرعاية النباتية الذكية بالرؤية الحاسوبية ومنصات التصنيع حسب الطلب إلى شبكات التوريد والمشتريات المؤسسية وأقوى البرامج التدريبية. صُمم كل مشروع وفق معايير دقيقة لكفاءة الأداء واستقرار بيئات الإنتاج.
        </p>

        <!-- Breadcrumb back link -->
        <div class="pt-2">
          <a
            href="/ar"
            class="text-xs font-mono text-text-muted hover:text-text inline-flex items-center gap-1.5 transition-colors"
          >
            → العودة إلى الصفحة الرئيسية
          </a>
        </div>
      </div>

      <!-- Projects Catalog Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
        {projects.map((project, idx) => (
          <Reveal delay={idx * 80}>
            <div class="rounded-2xl border border-border-strong bg-surface p-6 sm:p-8 flex flex-col justify-between space-y-6 hover:border-text transition-all duration-200 group h-full shadow-xs">
              <div class="space-y-5">
                <!-- Project Preview Image with Browser Bar -->
                <div class="rounded-xl overflow-hidden border border-border bg-bg/90 group-hover:border-border-strong transition-colors shadow-2xs">
                  <div class="flex items-center justify-between px-3 py-1.5 border-b border-border bg-surface-2/70 text-[10px] font-mono text-text-faint">
                    <div class="flex items-center gap-1.5" aria-hidden="true">
                      <span class="w-2 h-2 rounded-full bg-border-strong"></span>
                      <span class="w-2 h-2 rounded-full bg-border-strong"></span>
                      <span class="w-2 h-2 rounded-full bg-border-strong"></span>
                    </div>
                    <span class="truncate max-w-[180px] text-text-muted bidi-tech">{project.liveUrl ? project.liveUrl.replace('https://', '') : `${project.slug}.internal`}</span>
                    <span class="text-status">{project.status === 'live' ? '● مباشر' : '● نشط'}</span>
                  </div>
                  <a href={`/ar/work/${project.slug}`} class="block overflow-hidden aspect-[16/9] bg-surface-2">
                    <img
                      src={project.image}
                      alt={project.title}
                      class="w-full h-full object-cover object-top group-hover:scale-[1.02] transition-transform duration-300"
                      loading="lazy"
                      width="1280"
                      height="720"
                    />
                  </a>
                </div>

                <!-- Top Meta Bar -->
                <div class="flex items-center justify-between pb-3 border-b border-border text-xs font-mono">
                  <span class="text-text-faint uppercase tracking-wider">
                    {project.category} // <span class="bidi-tech">{project.year}</span>
                  </span>
                  <span class="text-xs font-mono px-2 py-0.5 rounded bg-surface-2 border border-border text-text">
                    {project.status === 'live' ? '● مباشر' : 'أبحاث'}
                  </span>
                </div>

                <!-- Title & Role -->
                <div>
                  <div class="text-xs font-mono text-text-muted uppercase tracking-wider">
                    الدور: {project.role}
                  </div>
                  <h2 class="text-2xl font-bold text-text tracking-tight font-sans mt-0.5 group-hover:underline">
                    <a href={`/ar/work/${project.slug}`}>
                      {project.title}
                    </a>
                  </h2>
                </div>

                <p class="text-sm text-text-muted leading-relaxed">
                  {project.summary}
                </p>

                <!-- Metrics if available -->
                {project.metrics && (
                  <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 py-3 border-y border-border/60 text-xs font-mono">
                    {project.metrics.slice(0, 2).map((m) => (
                      <div>
                        <div class="text-[10px] text-text-faint uppercase">{m.label}</div>
                        <div class="text-text font-bold text-xs mt-0.5 truncate bidi-tech">{m.value}</div>
                      </div>
                    ))}
                  </div>
                )}

                <!-- Bullets -->
                <ul class="space-y-1.5 text-xs text-text-muted font-mono pt-1">
                  {project.bullets.slice(0, 2).map((b) => (
                    <li class="flex items-start gap-2">
                      <span class="text-status font-bold">›</span>
                      <span class="leading-relaxed">{b}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Footer with Stack & Action Links -->
              <div class="pt-4 border-t border-border flex flex-wrap items-center justify-between gap-3">
                <TagList size="sm" tags={project.stack.slice(0, 3)} />

                <div class="flex items-center gap-3 text-xs font-mono">
                  <a
                    href={`/ar/work/${project.slug}`}
                    class="text-text font-bold hover:underline inline-flex items-center gap-1"
                  >
                    دراسة الحالة ←
                  </a>
                  {project.liveUrl && (
                    <a
                      href={project.liveUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-text-muted hover:text-text underline-offset-4 hover:underline"
                    >
                      زيارة المنصة ↗
                    </a>
                  )}
                  {project.repoUrl && (
                    <a
                      href={project.repoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-text-muted hover:text-text underline-offset-4 hover:underline"
                    >
                      GitHub ↗
                    </a>
                  )}
                </div>
              </div>
            </div>
          </Reveal>
        ))}
      </div>

      <!-- Bottom Inbound Work CTA -->
      <div class="border-t border-border pt-12">
        <div class="p-8 rounded-2xl border border-border-strong bg-surface-2 flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="space-y-2">
            <h3 class="text-2xl font-bold text-text">
              هل لديك فكرة منتج أو معمارية برمجية ترغب ببنائها؟
            </h3>
            <p class="text-sm text-text-muted max-w-xl">
              أتعاون مع رواد الأعمال وفرق التطوير والشركات على تطوير منصات الويب الحديثة وحلول الذكاء الاصطناعي المتكاملة.
            </p>
          </div>
          <Button href="/ar#contact" variant="primary" size="lg" class="shrink-0">
            لنناقش مشروعك معاً ←
          </Button>
        </div>
      </div>
    </div>
  </main>
</Base>
