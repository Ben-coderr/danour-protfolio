---
import Base from '../../../layouts/Base.astro';
import Button from '../../../components/ui/Button.astro';
import { CurriculumAccordion } from '../../../components/islands/CurriculumAccordion';

const workshopTopicsAr = [
  {
    title: 'الذكاء الاصطناعي التوليدي من الصفر للإنتاج',
    duration: 'معسكر من يومين إلى 4 أيام',
    audience: 'مهندسو البرمجيات والطلبة',
    desc: 'غوص مكثف في واجهات برمجة LLMs، استدعاء الدوال، قواعد البيانات الموجهة، وبناء تطبيقات ويب ذكية متكاملة.',
    tags: ['Next.js 15', 'FastAPI', 'Vercel AI SDK', 'Prompt Engineering'],
  },
  {
    title: 'معمارية أنظمة RAG للمؤسسات',
    duration: 'يوم تدريبي مكثف',
    audience: 'فرق الواجهات الخلفية والبيانات',
    desc: 'بناء خطوط استرجاع معرفي عالية الدقة من المستندات الخاصة مع استراتيجيات التقطيع والتصنيف وإعادة الترتيب.',
    tags: ['ChromaDB', 'PostgreSQL pgvector', 'Python', 'Embeddings'],
  },
  {
    title: 'الوكلاء الأذكياء واستدعاء الأدوات',
    duration: 'مختبر متقدم ليوم كامل',
    audience: 'كبار المطورين والمهندسين',
    desc: 'الانتقال إلى حلقات اتخاذ القرار الذاتية ReAct، مخططات الأدوات الصارمة، والتنفيذ الحتمي للأنظمة متعددة الوكلاء.',
    tags: ['Tool Calling', 'Pydantic', 'AsyncIO', 'Agent Workflows'],
  },
];
---

<Base
  title="المناهج التعليمية وورش العمل — عبد النور بن قريش"
  description="استكشف منهاج 'Build with AI' في Everest Academy، وورش العمل التقنية الحضورية، ومجتمع BenCoder البرمجي الذي يضم أكثر من 102,000 مطور."
  locale="ar"
>
  <main id="main" class="py-16 sm:py-24 space-y-24">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 md:px-12 space-y-20">
      <!-- Breadcrumb navigation -->
      <nav class="flex items-center gap-2 text-small text-text-muted" aria-label="Breadcrumb">
        <a href="/ar" class="hover:text-text transition-colors">الرئيسية</a>
        <span>/</span>
        <span class="text-text font-semibold">التعليم والتدريب</span>
      </nav>

      <!-- Hero Header -->
      <div class="space-y-4 pb-4">
        <h1 class="text-display text-text">
          جعل الذكاء الاصطناعي عملياً ومتاحاً للإنتاج
        </h1>
        <p class="text-lead text-text-muted max-prose">
          أصمم مناهج عملية، أقود معسكرات تدريب مكثفة، وأنتج شروحات برمجية هندسية رصينة لأكثر من 102,000 مطوّر عبر العالم العربي.
        </p>
      </div>

      <!-- Section 1: Everest Academy "Build with AI" -->
      <section class="space-y-10">
        <div class="space-y-2">
          <div class="text-small font-semibold text-text">Everest Academy · مستغانم</div>
          <h2 class="text-headline text-text">
            "Build with AI" — برنامج تدريبي مكثف لمدة شهر
          </h2>
          <p class="text-body text-text-muted max-prose">
            كبير مدربي الذكاء الاصطناعي ومصمم المنهاج. ينتقل بالطلاب من أساسيات هندسة السياق والموجهات إلى بناء تطبيقات متكاملة وشحن أصول تجارية احترافية.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
          <!-- Left: Methodology & Visuals -->
          <div class="lg:col-span-5 space-y-6">
            <div class="rounded-lg overflow-hidden bg-surface-2 aspect-16/10">
              <img
                src="/brand/everest-genai.jpg"
                alt="قاعة التدريب في Everest Academy"
                class="w-full h-full object-cover"
                loading="eager"
                width="800"
                height="500"
              />
            </div>

            <div class="bg-surface rounded-lg p-6 space-y-3">
              <h3 class="text-lg font-bold text-text">معمارية المنهاج التدريبي</h3>
              <p class="text-small text-text-muted leading-relaxed">
                أربع وحدات تطبيقية مصممة للمهندسين: هندسة سياق الموجهات، البرمجة السريعة بمساعدة الذكاء الاصطناعي، توليد الفيديو الحركي (Runway, Kling)، والتصميم الجرافيكي التجاري (Midjourney, FLUX.1).
              </p>
            </div>
          </div>

          <!-- Right: Interactive Syllabus -->
          <div class="lg:col-span-7">
            <CurriculumAccordion client:load />
          </div>
        </div>
      </section>

      <!-- Section 2: Udemy Course -->
      <section class="space-y-8 pt-8">
        <div class="space-y-2">
          <div class="text-small font-semibold text-text">دورة Udemy المسجلة</div>
          <h2 class="text-headline text-text">
            تعلم البرمجة بلغة بايثون من الصفر للمبتدئين
          </h2>
          <p class="text-body text-text-muted max-prose">
            مساقي التعليمي الأساسي الذي يضم أكثر من 300 طالب بتقييم 4.8. ترجمة المفاهيم البرمجية والخوارزمية إلى شرح عربي تطبيقي ومباشر.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center bg-surface rounded-lg p-8 sm:p-10">
          <div class="lg:col-span-5">
            <div class="rounded-lg overflow-hidden bg-surface-2 aspect-16/10">
              <img
                src="/brand/udemy-python.jpg"
                alt="غلاف دورة بايثون على Udemy"
                class="w-full h-full object-cover"
                loading="lazy"
                width="800"
                height="500"
              />
            </div>
          </div>

          <div class="lg:col-span-7 space-y-5">
            <div class="flex flex-wrap items-center gap-3 text-small text-text-muted">
              <span class="text-text font-bold">300+ طالب مسجل</span>
              <span>·</span>
              <span class="text-status font-semibold">تقييم 4.8 من 5.0</span>
              <span>·</span>
              <span>لغة عربية بالكامل</span>
            </div>

            <p class="text-body text-text-muted leading-relaxed max-prose">
              مصممة للمبتدئين وطلاب الجامعات الراغبين في بناء أساس خوارزمي قوي بلغة بايثون دون حشو نظري. تشمل المتغيرات، التحكم في التدفق، الدوال، النمذجة الكائنية OOP، وحل المسائل البرمجية.
            </p>

            <div class="pt-2">
              <Button href="https://www.udemy.com/course/bencoderr-python-course-arabic/" variant="primary" size="lg" target="_blank" rel="noopener noreferrer">
                التسجيل في دورة Udemy
              </Button>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 3: BenCoder Community Platform -->
      <section class="space-y-8 pt-8">
        <div class="space-y-2">
          <div class="text-small font-semibold text-text">المنصة وصناعة المحتوى (منذ 2022)</div>
          <h2 class="text-headline text-text">
            منصة BenCoder — أكثر من 102,000 مطوّر عربي
          </h2>
          <p class="text-body text-text-muted max-prose">
            نشر شروحات معمارية برمجية، وتطبيقات الذكاء الاصطناعي العملية، وتوجيهات مهنية عبر إنستغرام ويوتيوب.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center bg-surface rounded-lg p-8 sm:p-10">
          <div class="lg:col-span-7 space-y-5">
            <div class="text-small font-semibold text-text">
              102K+ مهندس وطالب ومؤسس تقني
            </div>
            <p class="text-body text-text-muted leading-relaxed max-prose">
              تأسست منصة BenCoder في عام 2022 لتقديم محتوى عربي عالي الجودة في علوم الحاسوب وتطبيقات الذكاء الاصطناعي. أكثر من 45 فيديو تفصيلي يغطي أطر عمل Next.js وبناء الواجهات الخلفية بـ FastAPI وتطوير البرمجيات.
            </p>
            <div class="pt-2">
              <Button href="https://instagram.com/ben.coderr" variant="secondary" size="md" target="_blank" rel="noopener noreferrer">
                زيارة حساب @ben.coderr على إنستغرام
              </Button>
            </div>
          </div>

          <div class="lg:col-span-5">
            <div class="rounded-lg overflow-hidden bg-surface-2 aspect-16/10">
              <img
                src="/brand/bencoder-instagram.jpg"
                alt="منصة BenCoder التقنية"
                class="w-full h-full object-cover"
                loading="lazy"
                width="800"
                height="500"
              />
            </div>
          </div>
        </div>
      </section>

      <!-- Section 4: Technical Workshops & University Seminars -->
      <section class="space-y-8 pt-8">
        <div class="space-y-2">
          <div class="text-small font-semibold text-text">التدريب الحضوري وورش العمل (منذ 2023)</div>
          <h2 class="text-headline text-text">
            ورش العمل التقنية والندوات الجامعية
          </h2>
          <p class="text-body text-text-muted max-prose">
            تقديم معسكرات تطبيقية وندوات خوارزمية عبر النوادي العلمية الجامعية والمراكز التقنية في تلمسان والجزائر العاصمة ووهران.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {
            workshopTopicsAr.map((item) => (
              <div class="bg-surface rounded-lg p-6 sm:p-8 space-y-4 flex flex-col justify-between">
                <div class="space-y-2">
                  <h3 class="text-xl font-bold text-text">{item.title}</h3>
                  <div class="text-small text-text-muted font-medium">{item.duration}</div>
                  <p class="text-body text-text-muted leading-relaxed">{item.desc}</p>
                </div>
                <div class="flex flex-wrap gap-1.5 pt-2">
                  {item.tags.map((tag) => (
                    <span class="text-small px-2.5 py-1 rounded bg-surface-2 text-text font-medium">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </main>
</Base>
