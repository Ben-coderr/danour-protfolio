---
import Base from '../../../layouts/Base.astro';
import { Image } from 'astro:assets';
import abdenourPortrait from '../../../assets/portrait/abdenour.jpg';
import Button from '../../../components/ui/Button.astro';

const toolsAndSetupAr = [
  {
    category: 'العتاد وبيئة العمل الفيزيائية',
    items: [
      'جهاز Apple Silicon Mac (M-Series) للهندسة البرمجية وتطوير النماذج',
      'شاشات مزدوجة عالية الدقة مضبوطة لراحة العين وفحص الواجهات',
      'لوحة مفاتيح ميكانيكية مخصصة لكتابة الأكواد والبرمجة الطويلة',
      'ميكروفون Shure MV7 احترافي لتسجيل الدروس التقنية لمنصة BenCoder',
    ],
  },
  {
    category: 'البرمجيات وبيئة التطوير',
    items: [
      'VS Code و Neovim مع تكوينات صارمة لفحص TypeScript وبايثون',
      'Ghostty و iTerm2 مع zsh و tmux وإعدادات dotfiles مخصصة',
      'Docker لحاويات قواعد البيانات المحلية واختبار الخدمات المصغرة',
      'TablePlus لإدارة وفحص قواعد بيانات PostgreSQL وعلاقاتها',
    ],
  },
  {
    category: 'أدوات الذكاء الاصطناعي وتعلم الآلة',
    items: [
      'Hugging Face Transformers و Datasets للترميز والتحليل المحلي',
      'PyTorch مع تسريع MPS/CUDA لتدريب وضبط النماذج',
      'ChromaDB و pgvector لتطبيقات البحث الدلالي وقواعد البيانات الموجهة',
      'Ollama لتشغيل واختبار النماذج اللغوية محلياً بدون إرسال البيانات خارجياً',
    ],
  },
];
---

<Base
  title="نبذة عن المهندس وفلسفة العمل — عبد النور بن قريش"
  description="تعرف على مسار عبد النور بن قريش (BenCoder): خلفيته الأكاديمية في هندسة النظم وعلوم البيانات، فلسفته البرمجية، وبيئة عمله اليومية."
  locale="ar"
>
  <main id="main" class="py-16 sm:py-24 space-y-20">
    <div class="max-w-5xl mx-auto px-6 sm:px-8 md:px-12 space-y-16">
      <!-- Breadcrumb navigation -->
      <nav class="flex items-center gap-2 text-small text-text-muted" aria-label="Breadcrumb">
        <a href="/ar" class="hover:text-text transition-colors">الرئيسية</a>
        <span>/</span>
        <span class="text-text font-semibold">من أنا</span>
      </nav>

      <!-- Header -->
      <div class="space-y-4 pb-6">
        <h1 class="text-display text-text">
          هندسة برمجية صارمة، وتعليم تقني واضح
        </h1>
        <p class="text-lead text-text-muted max-prose">
          القصة المهنية، القناعات الهندسية، وبيئة العمل اليومية لمدرب ذكاء اصطناعي ومهندس برمجيات متكامل في مستغانم، الجزائر.
        </p>
      </div>

      <!-- Section: Portrait & Long-Form Bio -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-start">
        <!-- Natural Color Portrait -->
        <div class="md:col-span-5 space-y-4">
          <div class="aspect-4/5 rounded-lg overflow-hidden bg-surface-2">
            <Image
              src={abdenourPortrait}
              alt="عبد النور بن قريش"
              class="w-full h-full object-cover"
              style="object-position: 42% 28%;"
              width={800}
              height={1000}
            />
          </div>
          <div class="space-y-1 text-small text-text-muted">
            <div class="font-semibold text-text">عبد النور بن قريش (BenCoder)</div>
            <div>مهندس دولة في الإعلام الآلي وعلوم البيانات (PFE 2026) · جامعة مستغانم</div>
            <div>مستغانم، الجزائر (UTC+1)</div>
          </div>
        </div>

        <!-- Long-Form Bio -->
        <div class="md:col-span-7 space-y-6 text-body text-text-muted leading-relaxed max-prose">
          <p class="text-xl font-medium text-text leading-relaxed">
            أنا مهندس برمجيات، مدرب ذكاء اصطناعي، وصانع محتوى تقني. أجمع بين الانضباط الرياضي الأكاديمي والحرفية البرمجية لبناء أنظمة تصمد أمام متطلبات الإنتاج الحقيقي.
          </p>

          <p>
            بدأت رحلتي بالبرمجة منخفضة المستوى والروبوتات المدمجة مع Arduino و ESP32 في مخابر DZDuino Labs. علمتني تلك التجربة تقدير قيود الذاكرة، وزمن استجابة الحساسات، والاعتمادية الصارمة. وعندما انتقلت إلى تعلم الآلة والأنظمة السحابية الموزعة، استمرت تلك القناعة: يجب أن يكون الكود قابلاً للمراقبة، سريعاً، وعملياً.
          </p>

          <p>
            في عام 2022، أطلقت منصة <strong class="text-text font-semibold">BenCoder</strong> لسد فجوة جوهرية: تقديم محتوى عربي عالي المستوى في علوم الحاسوب وتطبيقات الذكاء الاصطناعي دون اختصارات شكلية. اليوم، تضم المنصة أكثر من <strong class="text-text font-semibold">102,000 مطوّر</strong> عبر الجزائر والمنطقة العربية.
          </p>

          <p>
            في <strong class="text-text font-semibold">Everest Academy</strong>، أتولى قيادة معسكر "Build with AI" المكثف، لتدريب المهندسين على الانتقال من مجرد استخدام الذكاء الاصطناعي إلى بناء أنظمة حقيقية وتطبيقات متكاملة.
          </p>

          <div class="pt-4 flex flex-wrap gap-4">
            <Button href="/ar/work" variant="primary" size="md">
              استعراض المشاريع
            </Button>
            <Button href="/Abdenour_Benkorich_CV.pdf" variant="secondary" size="md" target="_blank" rel="noopener noreferrer">
              تحميل السيرة الذاتية (PDF)
            </Button>
          </div>
        </div>
      </div>

      <!-- Section: Workstation & Tooling -->
      <section class="space-y-8 pt-8">
        <div class="space-y-2">
          <h2 class="text-headline text-text">بيئة العمل والعتاد التقني</h2>
          <p class="text-body text-text-muted max-prose">
            الأدوات والبرمجيات التي أعتمد عليها يومياً في الهندسة وصناعة الدروس التقنية.
          </p>
        </div>

        <div class="space-y-6">
          {
            toolsAndSetupAr.map((sec) => (
              <div class="bg-surface rounded-lg p-6 sm:p-8 space-y-3">
                <h3 class="text-xl font-bold text-text">{sec.category}</h3>
                <ul class="space-y-2 text-small text-text-muted list-disc pr-4">
                  {sec.items.map((item) => (
                    <li class="leading-relaxed">{item}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </main>
</Base>
