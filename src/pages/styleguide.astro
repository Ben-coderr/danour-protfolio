---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import Tag from '../components/ui/Tag.astro';
import { ThemeToggle } from '../components/islands/ThemeToggle';
---

<Base title="Design System & Styleguide — BenCoder">
  <main id="main" class="max-w-7xl mx-auto px-6 sm:px-8 md:px-12 py-16 space-y-20">
    <!-- Styleguide Header -->
    <div class="space-y-4 pb-4">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="space-y-2">
          <div class="text-small font-semibold text-text-muted">DESIGN SYSTEM SPECIFICATION</div>
          <h1 class="text-display text-text">
            Abdenour Benkorich Styleguide
          </h1>
          <p class="text-lead text-text-muted max-prose">
            High-taste, anti-slop frontend architecture: clean neo-grotesk type (Switzer), tone-step surfaces, strict monochrome ground, and the green availability signal.
          </p>
        </div>

        <div class="flex items-center gap-3 p-3 rounded-md bg-surface-2">
          <span class="text-small text-text-muted">Theme:</span>
          <ThemeToggle client:load showLabel={true} />
        </div>
      </div>
    </div>

    <!-- 1. Color Tokens -->
    <section class="space-y-6">
      <div class="space-y-1">
        <div class="text-small font-semibold text-text-muted">COLOR TOKENS & CONTRAST</div>
        <h2 class="text-headline text-text">Semantic Color Palette</h2>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 pt-2">
        <div class="p-4 rounded-md bg-bg text-text space-y-2 bg-surface">
          <div class="w-full h-8 rounded bg-bg"></div>
          <div class="text-small font-semibold">--bg</div>
          <div class="text-small text-text-muted">#0A0A0A / #F8F8F8</div>
        </div>
        <div class="p-4 rounded-md bg-surface text-text space-y-2">
          <div class="w-full h-8 rounded bg-surface"></div>
          <div class="text-small font-semibold">--surface</div>
          <div class="text-small text-text-muted">#121212 / #FFFFFF</div>
        </div>
        <div class="p-4 rounded-md bg-surface text-text space-y-2">
          <div class="w-full h-8 rounded bg-surface-2"></div>
          <div class="text-small font-semibold">--surface-2</div>
          <div class="text-small text-text-muted">#181818 / #F0F0F0</div>
        </div>
        <div class="p-4 rounded-md bg-surface text-text space-y-2">
          <div class="w-full h-8 rounded bg-border"></div>
          <div class="text-small font-semibold">--border</div>
          <div class="text-small text-text-muted">#222222 / #E2E2E2</div>
        </div>
        <div class="p-4 rounded-md bg-surface text-text space-y-2">
          <div class="w-full h-8 rounded bg-invert-bg"></div>
          <div class="text-small font-semibold">--invert-bg</div>
          <div class="text-small text-text-muted">#F5F5F5 / #111111</div>
        </div>
        <div class="p-4 rounded-md bg-surface text-text space-y-2">
          <div class="w-full h-8 rounded bg-status"></div>
          <div class="text-small font-semibold">--status</div>
          <div class="text-small text-text-muted">#10B981 / #059669</div>
        </div>
      </div>
    </section>

    <!-- 2. Typography Scale -->
    <section class="space-y-6">
      <div class="space-y-1">
        <div class="text-small font-semibold text-text-muted">TYPOGRAPHY SCALE</div>
        <h2 class="text-headline text-text">Type Scale & Font Families</h2>
      </div>

      <div class="space-y-8 p-6 sm:p-10 rounded-lg bg-surface">
        <div>
          <div class="text-small text-text-muted mb-1">
            Monument Display · clamp(3.5rem, 14vw, 11rem) · Switzer
          </div>
          <div class="text-monument text-text">
            BENCODER
          </div>
        </div>

        <div class="pt-6">
          <div class="text-small text-text-muted mb-1">
            Display H1 · clamp(2.25rem, 5.5vw, 4.25rem)
          </div>
          <div class="text-display text-text">
            AI Systems & Software Architecture
          </div>
        </div>

        <div class="pt-6">
          <div class="text-small text-text-muted mb-1">
            Headline H2 · clamp(1.65rem, 3.2vw, 2.5rem)
          </div>
          <div class="text-headline text-text">Selected Work & Case Studies</div>
        </div>

        <div class="pt-6">
          <div class="text-small text-text-muted mb-1">
            Lead Paragraph · clamp(1.15rem, 1.8vw, 1.45rem)
          </div>
          <div class="text-lead text-text-muted max-prose">
            Lead AI instructor at Everest Academy and creator behind BenCoder (102,000+ developers). Bridging applied intelligence research to production code.
          </div>
        </div>

        <div class="pt-6">
          <div class="text-small text-text-muted mb-1">
            Body Text · clamp(1rem, 0.96rem + 0.2vw, 1.125rem)
          </div>
          <p class="text-body text-text-muted max-prose leading-relaxed">
            Every project is built with strict performance budgets, production reliability, and zero slop.
          </p>
        </div>
      </div>
    </section>

    <!-- 3. Components Preview -->
    <section class="space-y-6">
      <div class="space-y-1">
        <div class="text-small font-semibold text-text-muted">CORE COMPONENTS</div>
        <h2 class="text-headline text-text">Buttons & Tags</h2>
      </div>

      <div class="p-8 rounded-lg bg-surface space-y-6">
        <div class="flex flex-wrap gap-4 items-center">
          <Button variant="primary" size="lg">Primary Action (48px)</Button>
          <Button variant="secondary" size="md">Secondary Action</Button>
          <Button variant="ghost" size="sm">Ghost Button</Button>
        </div>

        <div class="flex flex-wrap gap-2 pt-2">
          <Tag text="Next.js 15" />
          <Tag text="FastAPI" />
          <Tag text="TypeScript" />
          <Tag text="PostgreSQL" />
          <Tag text="PyTorch" />
        </div>
      </div>
    </section>
  </main>
</Base>
