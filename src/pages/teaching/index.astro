---
import Base from '../../layouts/Base.astro';
import Button from '../../components/ui/Button.astro';
import { CurriculumAccordion } from '../../components/islands/CurriculumAccordion';

const workshopTopics = [
  {
    title: 'Generative AI from Zero to Production',
    duration: '2 to 4 Days Bootcamp',
    audience: 'Software Engineers and Students',
    desc: 'Intensive immersion into LLM APIs, function calling, vector embeddings, and building real AI web apps with streaming frontends.',
    tags: ['Next.js 15', 'FastAPI', 'Vercel AI SDK', 'Prompt Engineering'],
  },
  {
    title: 'Building Enterprise RAG Systems',
    duration: 'Full-Day Deep Dive',
    audience: 'Backend and Data Teams',
    desc: 'Architecting high-accuracy knowledge retrieval pipelines over private documents with chunking strategies, vector databases, and re-ranking.',
    tags: ['ChromaDB', 'PostgreSQL pgvector', 'Python', 'Embeddings'],
  },
  {
    title: 'Autonomous AI Agents & Tool Calling',
    duration: '1-Day Advanced Lab',
    audience: 'Senior Developers',
    desc: 'Moving beyond simple prompts to autonomous ReAct decision loops, tool schemas, deterministic execution, and stateful multi-agent systems.',
    tags: ['Tool Calling', 'Pydantic', 'AsyncIO', 'Agent Workflows'],
  },
];
---

<Base
  title="Teaching, Curriculums & Workshops — Abdenour Benkorich"
  description="Explore the 'Build with AI' generative AI curriculum, in-person engineering workshops, and the 102K+ BenCoder developer education community."
>
  <main id="main" class="py-16 sm:py-24 space-y-24">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 md:px-12 space-y-20">
      <!-- Breadcrumb navigation -->
      <nav class="flex items-center gap-2 text-small text-text-muted" aria-label="Breadcrumb">
        <a href="/" class="hover:text-text transition-colors">Home</a>
        <span>/</span>
        <span class="text-text font-semibold">Teaching</span>
      </nav>

      <!-- Hero Header -->
      <div class="space-y-4 pb-4">
        <h1 class="text-display text-text">
          Making AI Practical, Accessible and Production-Ready
        </h1>
        <p class="text-lead text-text-muted max-prose">
          I design hands-on curricula, conduct intensive bootcamps, and create practical software engineering tutorials for over 102,000 developers worldwide.
        </p>
      </div>

      <!-- Section 1: Everest Academy "Build with AI" -->
      <section class="space-y-10">
        <div class="space-y-2">
          <div class="text-small font-semibold text-text">Everest Academy · Mostaganem</div>
          <h2 class="text-headline text-text">
            "Build with AI" — One-Month Intensive Curriculum
          </h2>
          <p class="text-body text-text-muted max-prose">
            Lead Generative AI Instructor and Course Architect. Taking students from fundamental prompt engineering and context reasoning to shipping full-stack applications and commercial visual assets.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
          <!-- Left: Methodology & Visuals -->
          <div class="lg:col-span-5 space-y-6">
            <div class="rounded-lg overflow-hidden bg-surface-2 aspect-16/10">
              <img
                src="/brand/everest-genai.jpg"
                alt="Everest Academy Build with AI Classroom"
                class="w-full h-full object-cover"
                loading="eager"
                width="800"
                height="500"
              />
            </div>

            <div class="bg-surface rounded-lg p-6 space-y-3">
              <h3 class="text-lg font-bold text-text">Course Architecture</h3>
              <p class="text-small text-text-muted leading-relaxed">
                Four hands-on modules designed for modern engineers: Prompt Context Engineering, Vibe Coding with AI pair programming, Diffusion Video Synthesis (Runway Gen-3, Kling), and Generative Commercial Assets (Midjourney, FLUX.1).
              </p>
            </div>
          </div>

          <!-- Right: Interactive Syllabus -->
          <div class="lg:col-span-7">
            <CurriculumAccordion client:load />
          </div>
        </div>
      </section>

      <!-- Section 2: Udemy Course -->
      <section class="space-y-8 pt-8">
        <div class="space-y-2">
          <div class="text-small font-semibold text-text">Udemy Online Course</div>
          <h2 class="text-headline text-text">
            Python for Beginners in Arabic
          </h2>
          <p class="text-body text-text-muted max-prose">
            My foundational programming course with over 300 students and a 4.8 rating. Translating core computational concepts into accessible Arabic instruction.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center bg-surface rounded-lg p-8 sm:p-10">
          <div class="lg:col-span-5">
            <div class="rounded-lg overflow-hidden bg-surface-2 aspect-16/10">
              <img
                src="/brand/udemy-python.jpg"
                alt="Udemy Python Course Cover"
                class="w-full h-full object-cover"
                loading="lazy"
                width="800"
                height="500"
              />
            </div>
          </div>

          <div class="lg:col-span-7 space-y-5">
            <div class="flex flex-wrap items-center gap-3 text-small text-text-muted">
              <span class="text-text font-bold">300+ Students</span>
              <span>·</span>
              <span class="text-status font-semibold">4.8 / 5.0 Rating</span>
              <span>·</span>
              <span>Arabic Instruction</span>
            </div>

            <p class="text-body text-text-muted leading-relaxed max-prose">
              Designed for newcomers and university students seeking pragmatic mastery of Python without theoretical fluff. Covers variables, control flow, functions, modular architecture, algorithmic problem solving, and object-oriented programming.
            </p>

            <div class="pt-2">
              <Button href="https://www.udemy.com/course/bencoderr-python-course-arabic/" variant="primary" size="lg" target="_blank" rel="noopener noreferrer">
                Enroll on Udemy
              </Button>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 3: BenCoder Community Platform -->
      <section class="space-y-8 pt-8">
        <div class="space-y-2">
          <div class="text-small font-semibold text-text">Developer Media (est. 2022)</div>
          <h2 class="text-headline text-text">
            BenCoder — 102,000+ Arabic Tech Community
          </h2>
          <p class="text-body text-text-muted max-prose">
            Publishing practical software architecture breakdowns, AI agent tutorials, and career roadmaps across Instagram and YouTube.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center bg-surface rounded-lg p-8 sm:p-10">
          <div class="lg:col-span-7 space-y-5">
            <div class="text-small font-semibold text-text">
              102K+ Engineers, Students & Founders
            </div>
            <p class="text-body text-text-muted leading-relaxed max-prose">
              BenCoder was established in 2022 to deliver high-quality, jargon-free computer science and AI education natively in Arabic. Over 45 video guides cover full-stack engineering with Next.js, API design with FastAPI, and production deployment.
            </p>
            <div class="pt-2">
              <Button href="https://instagram.com/ben.coderr" variant="secondary" size="md" target="_blank" rel="noopener noreferrer">
                Visit @ben.coderr on Instagram
              </Button>
            </div>
          </div>

          <div class="lg:col-span-5">
            <div class="rounded-lg overflow-hidden bg-surface-2 aspect-16/10">
              <img
                src="/brand/bencoder-instagram.jpg"
                alt="BenCoder Community Platform"
                class="w-full h-full object-cover"
                loading="lazy"
                width="800"
                height="500"
              />
            </div>
          </div>
        </div>
      </section>

      <!-- Section 4: Technical Workshops & University Seminars -->
      <section class="space-y-8 pt-8">
        <div class="space-y-2">
          <div class="text-small font-semibold text-text">In-Person Instruction (since 2023)</div>
          <h2 class="text-headline text-text">
            Technical Workshops & University Seminars
          </h2>
          <p class="text-body text-text-muted max-prose">
            Delivering hands-on bootcamps and algorithmic seminars across university clubs and tech hubs in Tlemcen, Algiers, and Oran.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {
            workshopTopics.map((item) => (
              <div class="bg-surface rounded-lg p-6 sm:p-8 space-y-4 flex flex-col justify-between">
                <div class="space-y-2">
                  <h3 class="text-xl font-bold text-text">{item.title}</h3>
                  <div class="text-small text-text-muted font-medium">{item.duration}</div>
                  <p class="text-body text-text-muted leading-relaxed">{item.desc}</p>
                </div>
                <div class="flex flex-wrap gap-1.5 pt-2">
                  {item.tags.map((tag) => (
                    <span class="text-small px-2.5 py-1 rounded bg-surface-2 text-text font-medium">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </main>
</Base>
