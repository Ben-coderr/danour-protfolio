---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
---

<Base
  title="404 — Route Not Found | Abdenour Benkorich"
  description="The requested page could not be located. Return to the homepage or explore engineering projects."
>
  <main id="main" class="min-h-[75vh] flex items-center justify-center py-20 px-4">
    <div class="max-w-[650px] w-full rounded-2xl border border-border-strong bg-surface p-6 sm:p-10 shadow-lg space-y-8 font-mono select-none">
      <!-- Terminal Window Bar -->
      <div class="flex items-center justify-between pb-4 border-b border-border text-xs">
        <div class="flex items-center gap-1.5" aria-hidden="true">
          <span class="w-3 h-3 rounded-full bg-border-strong border border-border inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-border-strong border border-border inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-border-strong border border-border inline-block"></span>
        </div>
        <span class="text-text-muted text-[11px]">
          bencoder-shell <span class="text-text-faint">v2.4.0</span>
        </span>
        <span class="text-status text-[10px] font-bold">● ONLINE</span>
      </div>

      <!-- Error Readout -->
      <div class="space-y-4">
        <div class="space-y-1">
          <div class="text-status text-xs font-bold">$ bencoder-cli route-resolve</div>
          <div class="text-4xl sm:text-5xl font-extrabold text-text font-sans tracking-tight">
            Error 404
          </div>
          <p class="text-xs text-text-faint uppercase tracking-wider">
            HTTP_STATUS_NOT_FOUND // ROUTE_DISCONNECTED
          </p>
        </div>

        <div class="p-4 rounded-xl border border-border bg-surface-2 text-xs text-text-muted leading-relaxed">
          The requested URL path does not exist on this server, was refactored into a new module, or is restricted to internal production access.
        </div>
      </div>

      <!-- Quick Route Recovery -->
      <div class="space-y-3 pt-2 border-t border-border">
        <div class="text-[11px] text-text-faint uppercase tracking-wider">
          Available Navigation Shortcuts:
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
          <a
            href="/"
            class="p-3 rounded-lg border border-border bg-surface-2/60 hover:bg-surface-2 hover:border-text transition-colors flex items-center justify-between group"
          >
            <span class="text-text font-bold">01 // Homepage</span>
            <span class="text-text-faint group-hover:translate-x-1 transition-transform">→</span>
          </a>
          <a
            href="/work"
            class="p-3 rounded-lg border border-border bg-surface-2/60 hover:bg-surface-2 hover:border-text transition-colors flex items-center justify-between group"
          >
            <span class="text-text font-bold">02 // Project Archive</span>
            <span class="text-text-faint group-hover:translate-x-1 transition-transform">→</span>
          </a>
          <a
            href="/teaching"
            class="p-3 rounded-lg border border-border bg-surface-2/60 hover:bg-surface-2 hover:border-text transition-colors flex items-center justify-between group"
          >
            <span class="text-text font-bold">03 // AI Teaching</span>
            <span class="text-text-faint group-hover:translate-x-1 transition-transform">→</span>
          </a>
          <a
            href="/about"
            class="p-3 rounded-lg border border-border bg-surface-2/60 hover:bg-surface-2 hover:border-text transition-colors flex items-center justify-between group"
          >
            <span class="text-text font-bold">04 // Biography &amp; Setup</span>
            <span class="text-text-faint group-hover:translate-x-1 transition-transform">→</span>
          </a>
        </div>
      </div>

      <!-- Main Action -->
      <div class="pt-2">
        <Button href="/" variant="primary" size="md" class="w-full text-center">
          Return to portfolio home →
        </Button>
      </div>
    </div>
  </main>
</Base>
