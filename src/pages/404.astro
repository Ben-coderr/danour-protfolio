---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
---

<Base
  title="404 — Page Not Found | Abdenour Benkorich"
  description="The requested page could not be located. Return to the homepage or explore engineering projects."
>
  <main id="main" class="min-h-[70dvh] flex items-center justify-center py-20 px-6 sm:px-8 md:px-12">
    <div class="max-w-xl w-full bg-surface rounded-lg p-8 sm:p-12 space-y-6 text-center">
      <div class="text-monument text-text leading-none select-none opacity-20" aria-hidden="true">
        404
      </div>

      <div class="space-y-3">
        <h1 class="text-headline text-text">Page Not Found</h1>
        <p class="text-body text-text-muted leading-relaxed max-prose mx-auto">
          The requested URL does not exist or may have been moved. Return to the homepage to explore engineering projects and AI curriculum.
        </p>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
        <Button href="/" variant="primary" size="lg">
          Return to Homepage
        </Button>
        <Button href="/work" variant="secondary" size="lg">
          Selected Work
        </Button>
      </div>
    </div>
  </main>
</Base>
