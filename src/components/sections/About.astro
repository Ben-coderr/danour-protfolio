---
import { Image } from 'astro:assets';
import abdenourPortrait from '../../assets/portrait/abdenour.jpg';
import SectionLabel from '../ui/SectionLabel.astro';
import Card from '../ui/Card.astro';
import Reveal from '../ui/Reveal.astro';

const principles = [
  {
    num: '01',
    title: 'Practical over theoretical',
    desc: 'Start with the user outcome; select models, frameworks, and architectures that operate efficiently and reliably in real-world environments.',
  },
  {
    num: '02',
    title: 'Teach what I build',
    desc: 'Every curriculum and tutorial stems from real code shipped into production, rather than abstract, untethered theory.',
  },
  {
    num: '03',
    title: 'Local relevance',
    desc: 'Dedicated to AI models, datasets, and linguistic applications that genuinely serve Algerian users and local industry demands.',
  },
  {
    num: '04',
    title: 'Ship small, ship often',
    desc: 'Frequent feedback loops beat speculative planning. Build modularly, test rigorously, and iterate continuously.',
  },
];
---

<section id="about" class="py-20 md:py-28 scroll-mt-20">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
    <!-- Header -->
    <div class="border-b border-border pb-8">
      <SectionLabel number="03" label="ABOUT &amp; VALUES" />
      <h2 class="text-headline text-text mt-3">
        Bridging the gap between <span class="font-accent">research</span> and production
      </h2>
    </div>

    <!-- Main Content -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <!-- Left Column: Portrait & Facts -->
      <div class="lg:col-span-5 space-y-6">
        <!-- Portrait Frame / Visual Representation -->
        <Reveal delay={0}>
          <Card padding="none" class="overflow-hidden border-border-strong group">
            <div class="relative aspect-3/4 sm:aspect-4/5 overflow-hidden bg-surface-2">
              <Image
                src={abdenourPortrait}
                alt="Abdenour Benkorich - AI Instructor & Full-Stack Engineer"
                class="w-full h-full object-cover grayscale contrast-[1.06] brightness-[0.96] group-hover:scale-[1.02] transition-transform duration-500"
                style="object-position: 42% 28%;"
                width={900}
                height={1200}
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-linear-to-t from-bg via-transparent to-transparent opacity-60"></div>
              
              <!-- Bottom identity bar overlay -->
              <div class="absolute bottom-0 inset-x-0 p-4 sm:p-5 bg-gradient-to-t from-bg/95 to-transparent flex items-end justify-between">
                <div>
                  <div class="text-base font-bold text-text">Abdenour Benkorich</div>
                  <div class="text-xs font-mono text-text-muted">BenCoder · AI Instructor</div>
                </div>
                <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-surface/90 border border-border text-text backdrop-blur-xs">
                  Mostaganem, DZ
                </span>
              </div>
            </div>
          </Card>
        </Reveal>

        <!-- Quick Facts Summary -->
        <Reveal delay={100}>
          <div class="p-6 rounded-[14px] border border-border bg-surface space-y-3">
            <div class="font-mono text-xs uppercase tracking-wider text-text-faint">Fast Facts</div>
            <div class="divide-y divide-border/60 text-xs font-mono">
              <div class="py-2 flex justify-between">
                <span class="text-text-muted">Education</span>
                <span class="text-text font-medium">B.Sc. Data Science (2024–2028)</span>
              </div>
              <div class="py-2 flex justify-between">
                <span class="text-text-muted">University</span>
                <span class="text-text font-medium">Univ. of Mostaganem</span>
              </div>
              <div class="py-2 flex justify-between">
                <span class="text-text-muted">Brand</span>
                <span class="text-text font-medium">BenCoder (102K+ Followers)</span>
              </div>
              <div class="py-2 flex justify-between">
                <span class="text-text-muted">Languages</span>
                <span class="text-text font-medium">Arabic (Native), English, French</span>
              </div>
              <div class="py-2 flex justify-between">
                <span class="text-text-muted">Current Focus</span>
                <span class="text-status font-medium">Tassili AI (Algerian LLM)</span>
              </div>
            </div>
          </div>
        </Reveal>
      </div>

      <!-- Right Column: Story & Principles -->
      <div class="lg:col-span-7 space-y-8">
        <Reveal delay={120}>
          <div class="space-y-4 text-base sm:text-lg text-text-muted leading-relaxed">
            <p>
              I am a Computer Engineering &amp; Data Science student and full-stack developer who believes the real power of modern AI lies in <strong class="text-text font-semibold">tangible utility</strong> rather than hype. Operating from Mostaganem, Algeria, I contribute to the <strong class="text-text font-semibold">Tassili AI</strong> initiative building an Algerian LLM, while engineering full-stack platforms for startups and commercial clients.
            </p>
            <p>
              Through Everest Academy's <em class="text-text font-normal">"Build with AI"</em> curriculum and my creator platform <strong class="text-text font-semibold">BenCoder</strong>, I teach over 102,000 developers how to move from first principles to functional, deployed software. The best software engineers teach what they ship, and the best instructors continuously test their ideas against production constraints.
            </p>
          </div>
        </Reveal>

        <!-- 4 Numbered Principles Grid -->
        <Reveal delay={200}>
          <div class="space-y-4 pt-4 border-t border-border">
            <div class="font-mono text-xs uppercase tracking-wider text-text-faint">Guiding Engineering Principles:</div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {principles.map((p) => (
                <div class="p-5 rounded-xl border border-border bg-surface space-y-2 hover:border-border-strong transition-colors">
                  <div class="font-mono text-xs text-text-faint font-semibold">{p.num} //</div>
                  <h4 class="font-bold text-text text-base">{p.title}</h4>
                  <p class="text-xs text-text-muted leading-relaxed">{p.desc}</p>
                </div>
              ))}
            </div>
          </div>
        </Reveal>
      </div>
    </div>
  </div>
</section>
