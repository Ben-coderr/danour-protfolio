---
import { Image } from 'astro:assets';
import abdenourPortrait from '../../assets/portrait/abdenour.jpg';
import Button from '../ui/Button.astro';
import { useTranslations, type Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const {
  locale = (Astro.currentLocale as Locale) || (Astro.url.pathname.startsWith('/ar') ? 'ar' : 'en'),
} = Astro.props;

const t = useTranslations(locale);
const basePrefix = locale === 'ar' ? '/ar' : '';
---

<section id="about" class="py-20 md:py-28 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 md:px-12 space-y-16">
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-4">
      <div class="space-y-3">
        <h2 class="text-headline text-text">
          {locale === 'ar' ? 'حول المهندس والمدرب' : 'Engineering Stance & Background'}
        </h2>
        <p class="text-body text-text-muted max-prose">
          {
            locale === 'ar'
              ? 'الجمع بين النمذجة الرياضية الصارمة لعلوم البيانات والتطوير البرمجي السريع لشحن حلول حقيقية.'
              : 'Combining mathematical rigor from data science with rapid software engineering to ship practical platforms.'
          }
        </p>
      </div>

      <Button href={`${basePrefix}/about`} variant="secondary" size="md">
        {t('section.03.readMore')}
      </Button>
    </div>

    <!-- Editorial Spread: Left Facts & Portrait / Right Wide Paragraph -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Left Column: Portrait & Side Facts -->
      <div class="lg:col-span-5 space-y-6" data-reveal>
        <div class="rounded-lg overflow-hidden bg-surface-2 aspect-4/5 max-w-md">
          <Image
            src={abdenourPortrait}
            alt="Abdenour Benkorich"
            class="w-full h-full object-cover"
            loading="lazy"
            width={600}
            height={750}
          />
        </div>

        <div class="space-y-4 pt-2">
          <div class="space-y-1">
            <div class="text-small text-text font-semibold">Abdenour Benkorich (BenCoder)</div>
            <div class="text-small text-text-muted">
              {
                locale === 'ar'
                  ? 'مهندس دولة في الإعلام الآلي وعلوم البيانات (PFE 2026) · جامعة عبد الحميد بن باديس مستغانم'
                  : 'State Engineering Degree in Computer Engineering & Data Science (PFE 2026) · Universite Abdelhamid Ibn Badis'
              }
            </div>
          </div>

          <div class="space-y-1">
            <div class="text-small text-text font-semibold">Location & Timezone</div>
            <div class="text-small text-text-muted">Mostaganem, Algeria · UTC+1 (Worldwide Remote)</div>
          </div>

          <div class="space-y-1">
            <div class="text-small text-text font-semibold">Primary Teaching Role</div>
            <div class="text-small text-text-muted">Lead AI Instructor @ Everest Academy</div>
          </div>
        </div>
      </div>

      <!-- Right Column: Wide Confident Paragraphs -->
      <div class="lg:col-span-7 space-y-8" data-reveal>
        <p class="text-xl sm:text-2xl font-medium text-text leading-relaxed tracking-tight max-prose">
          {
            locale === 'ar'
              ? 'المنفعة العملية تسبق البريق الدعائي. أفضل نظام ذكاء اصطناعي هو الذي ينجز عملاً حقيقياً وموثوقاً بزمن استجابة سريع وتكلفة منضبطة. أمنح الأولوية للنماذج المُثبتة في بيئات الإنتاج، والمخرجات الهيكلية الدقيقة، وخطوط المعالجة القابلة للمراقبة.'
              : 'Practical utility over speculative hype. The best AI system is one that reliably performs real work at low latency and reasonable cost. I prioritize production-tested models, strict structured outputs, and observable pipelines over theoretical benchmarks.'
          }
        </p>

        <div class="space-y-6 text-body text-text-muted leading-relaxed max-prose">
          <p>
            {
              locale === 'ar'
                ? 'أعلّم ما أبنيه في الإنتاج، وأبني ما أعلّمه. كل ورشة عمل في Everest Academy وكل دليل تقني على منصة BenCoder ينبع مباشرة من كود كُتب وحُلّت مشاكله في بيئات عمل فعلية. التدريس يفرض وضوحاً هندسياً مطلقاً لا يقبل الافتراضات غير المختبرة.'
                : 'Teach what you ship, ship what you teach. Every workshop module at Everest Academy and every technical tutorial on BenCoder stems directly from code written and debugged in production environments. Teaching forces absolute architectural clarity.'
            }
          </p>

          <p>
            {
              locale === 'ar'
                ? 'دورات تطوير سريعة وتحديثات مستمرة: الشحن المستمر والمبكر يتفوق على الخطط النظرية الطويلة. أنشر أجزاء متقنة ومُراقبة جيداً، واجمع آراء المستخدمين، وطوّر المعمارية باستمرار دون تعقيدات شكلية.'
                : 'Tight feedback loops beat speculative roadmaps. Ship small, instrument thoroughly, gather user feedback, and iterate the architecture with high cadence and zero ceremony.'
            }
          </p>
        </div>

        <div class="pt-4">
          <Button href="/Abdenour_Benkorich_CV.pdf" variant="secondary" size="md" target="_blank" rel="noopener noreferrer">
            {t('nav.downloadCv')}
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>
