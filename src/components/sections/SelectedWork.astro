---
import { projects } from '../../data/projects';
import SectionLabel from '../ui/SectionLabel.astro';
import TagList from '../ui/TagList.astro';
import Button from '../ui/Button.astro';
import Reveal from '../ui/Reveal.astro';

const flagshipProject = projects.find((p) => p.slug === 'jg-supply-net') || projects[0];
const secondaryProjects = projects.filter((p) => ['phytosense', 'vyro', 'new-way', 'virexa'].includes(p.slug));
const clientProjects = projects.filter((p) => ['udemy-python-arabic', 'everest-genai', 'fiikra-studio', 'perfecto-brew-crew'].includes(p.slug));
---

<section id="work" class="py-20 md:py-28 scroll-mt-20 relative">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-border pb-8">
      <div class="space-y-3">
        <SectionLabel number="01" label="SELECTED WORK" />
        <h2 class="text-headline text-text">
          Featured Projects &amp; <span class="font-accent">Architectures</span>
        </h2>
        <p class="text-text-muted text-base max-w-xl leading-relaxed">
          Algeria's digital B2B procurement platform, resilient botanical AI, made-to-order manufacturing, and AI revenue forecasting SaaS.
        </p>
      </div>

      <Button href="/work" variant="secondary" size="md">
        View all projects archive →
      </Button>
    </div>

    <!-- Featured Project #1: Full-Bleed Cinematic Feature (JG SupplyNet - Latest Work) -->
    <Reveal delay={0}>
      <div class="rounded-2xl border border-border-strong bg-surface overflow-hidden shadow-md group">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
          <!-- Left: Narrative & Engineering Highlights -->
          <div class="lg:col-span-7 p-6 sm:p-8 lg:p-10 flex flex-col justify-between space-y-6">
            <div class="space-y-4">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-status animate-pulse"></span>
                  <span class="font-mono text-xs uppercase tracking-wider text-text font-bold">
                    LATEST PRODUCTION WORK // B2B MARKETPLACE
                  </span>
                </div>
                <span class="text-xs font-mono text-text px-2 py-0.5 rounded bg-surface-2 border border-border">
                  2025 — 2026
                </span>
              </div>

              <h3 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-text tracking-tight font-sans">
                {flagshipProject.title}
              </h3>

              <p class="text-sm sm:text-base text-text-muted leading-relaxed">
                Architected Algeria's modern digital B2B procurement platform for Jamael Group. Enables institutions, commercial buyers, and verified suppliers to publish purchase requests, explore technical catalogs, and streamline quotation pipelines.
              </p>

              <!-- Technical HUD Readouts -->
              <div class="grid grid-cols-3 gap-3 py-3 border-y border-border/70 text-xs font-mono">
                <div>
                  <div class="text-[10px] text-text-faint uppercase">Platform Model</div>
                  <div class="text-text font-bold mt-0.5">B2B Sourcing Hub</div>
                </div>
                <div>
                  <div class="text-[10px] text-text-faint uppercase">Localization</div>
                  <div class="text-text font-bold mt-0.5">EN · FR · AR</div>
                </div>
                <div>
                  <div class="text-[10px] text-text-faint uppercase">Role</div>
                  <div class="text-status font-bold mt-0.5">Lead Full-Stack</div>
                </div>
              </div>

              <!-- Outcomes -->
              <ul class="space-y-1.5 text-xs sm:text-sm text-text-muted font-mono pt-1">
                {flagshipProject.bullets.map((bullet) => (
                  <li class="flex items-start gap-2">
                    <span class="text-status font-bold select-none">›</span>
                    <span class="leading-relaxed">{bullet}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-4 border-t border-border flex flex-wrap items-center justify-between gap-4">
              <TagList size="sm" tags={flagshipProject.stack} />
              <div class="flex items-center gap-3">
                {flagshipProject.liveUrl && (
                  <a
                    href={flagshipProject.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs font-mono text-text font-bold hover:underline inline-flex items-center gap-1"
                  >
                    Visit Live Site ↗
                  </a>
                )}
                <Button href={`/work/${flagshipProject.slug}`} variant="ghost" size="sm">
                  Case study →
                </Button>
              </div>
            </div>
          </div>

          <!-- Right: Live Platform Screen Preview & Telemetry -->
          <div class="lg:col-span-5 bg-surface-2 p-6 sm:p-8 flex flex-col justify-between border-t lg:border-t-0 lg:border-l border-border relative">
            <div class="space-y-4 font-mono text-xs">
              <div class="flex items-center justify-between pb-3 border-b border-border/70 text-text-faint">
                <span class="text-[11px]">// B2B SOURCING ENGINE</span>
                <span class="text-[10px] px-2 py-0.5 rounded bg-bg text-status border border-border font-bold">● PRODUCTION LIVE</span>
              </div>

              <!-- Real Platform Screenshot Preview in Browser Mockup Frame -->
              <div class="rounded-xl overflow-hidden border border-border bg-bg shadow-sm group/preview">
                <div class="flex items-center justify-between px-3 py-2 border-b border-border/70 bg-surface/70 text-[10px] text-text-faint">
                  <div class="flex items-center gap-1.5" aria-hidden="true">
                    <span class="w-2 h-2 rounded-full bg-border-strong"></span>
                    <span class="w-2 h-2 rounded-full bg-border-strong"></span>
                    <span class="w-2 h-2 rounded-full bg-border-strong"></span>
                  </div>
                  <span class="text-[10px] text-text-muted">jgsupplynet.com/en</span>
                  <span class="text-[9px] text-status font-bold">LIVE VERCEL</span>
                </div>
                <a href={flagshipProject.liveUrl} target="_blank" rel="noopener noreferrer" class="block aspect-[16/10] overflow-hidden bg-surface-2">
                  <img
                    src={flagshipProject.image}
                    alt="JG SupplyNet Live Platform"
                    class="w-full h-full object-cover group-hover/preview:scale-[1.02] transition-transform duration-300"
                    loading="eager"
                    width="1280"
                    height="720"
                  />
                </a>
              </div>

              <!-- Key Value Proposition Preview -->
              <div class="p-3.5 rounded-xl border border-border bg-bg/60 space-y-2">
                <div class="text-[10px] text-text-faint uppercase tracking-wider">PLATFORM SCOPE</div>
                <div class="flex items-baseline justify-between">
                  <span class="text-lg font-bold text-text font-sans">Connecting Organizations</span>
                  <span class="text-xs font-mono text-status font-semibold">with Trusted Suppliers</span>
                </div>
                <p class="text-[11px] text-text-muted font-sans leading-normal">
                  One platform to manage procurement, discover qualified suppliers, and streamline B2B sourcing across Algeria.
                </p>
              </div>
            </div>

            <div class="pt-4 text-center">
              <span class="text-[11px] font-mono text-text-faint">
                Developed for Jamael Group · Shipped 2025/2026
              </span>
            </div>
          </div>
        </div>
      </div>
    </Reveal>

    <!-- 2-Column Paired Featured Projects (Virexa & Fiikra) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {secondaryProjects.map((project, idx) => (
        <Reveal delay={120 + idx * 80}>
          <div class="rounded-2xl border border-border bg-surface p-6 sm:p-8 flex flex-col justify-between space-y-6 hover:border-border-strong transition-all duration-200 group h-full shadow-xs">
            <div class="space-y-5">
              <!-- Browser Mockup Window with Image Preview -->
              <div class="rounded-xl overflow-hidden border border-border bg-bg/90 group-hover:border-border-strong transition-colors shadow-2xs">
                <div class="flex items-center justify-between px-3.5 py-2 border-b border-border bg-surface-2/70 text-xs font-mono text-text-faint">
                  <div class="flex items-center gap-1.5" aria-hidden="true">
                    <span class="w-2.5 h-2.5 rounded-full bg-border-strong inline-block"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-border-strong inline-block"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-border-strong inline-block"></span>
                  </div>
                  <span class="truncate max-w-[180px] text-[10px] text-text-muted font-mono">{project.liveUrl?.replace('https://', '')}</span>
                  {project.status === 'live' && (
                    <span class="text-status text-[10px] font-medium">● LIVE</span>
                  )}
                </div>
                <a href={project.liveUrl || `/work/${project.slug}`} class="block overflow-hidden aspect-[16/10] bg-surface-2">
                  <img
                    src={project.image}
                    alt={project.title}
                    class="w-full h-full object-cover object-top group-hover:scale-[1.02] transition-transform duration-300"
                    loading="lazy"
                    width="1280"
                    height="720"
                  />
                </a>
              </div>

              <!-- Title & Category -->
              <div>
                <span class="text-[11px] font-mono uppercase tracking-wider text-text-faint">
                  {project.role} // {project.year}
                </span>
                <h3 class="text-xl sm:text-2xl font-bold text-text tracking-tight font-sans mt-0.5 group-hover:text-text transition-colors">
                  {project.title}
                </h3>
              </div>

              <p class="text-sm text-text-muted leading-relaxed">
                {project.summary}
              </p>

              <!-- Bullets -->
              <ul class="space-y-1.5 text-xs text-text-muted font-mono pt-1">
                {project.bullets.map((b) => (
                  <li class="flex items-start gap-2">
                    <span class="text-text font-bold">›</span>
                    <span class="leading-relaxed">{b}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Footer Stack & Visit Link -->
            <div class="pt-4 border-t border-border flex flex-wrap items-center justify-between gap-3">
              <TagList size="sm" tags={project.stack} />
              {project.liveUrl && (
                <a
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs font-mono text-text font-bold hover:underline inline-flex items-center gap-1"
                >
                  Visit Live Site ↗
                </a>
              )}
            </div>
          </div>
        </Reveal>
      ))}
    </div>

    <!-- Commercial & Client Deployments Data Strip (No Boxy Cards) -->
    <Reveal delay={240}>
      <div class="border-t border-border pt-10 space-y-6">
        <div class="flex items-center justify-between">
          <span class="font-mono text-xs uppercase tracking-wider text-text-faint">
            // MORE COMMERCIAL &amp; CLIENT DEPLOYMENTS
          </span>
          <a href="/work" class="text-xs font-mono text-text hover:underline">
            Browse complete catalog →
          </a>
        </div>

        <div class="border border-border rounded-xl divide-y divide-border bg-surface/40 overflow-hidden text-xs font-mono">
          {clientProjects.map((p) => (
            <div class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-surface transition-colors group/row">
              <div class="flex items-center gap-4 min-w-0">
                <div class="w-16 h-11 rounded-lg overflow-hidden border border-border bg-surface-2 shrink-0 hidden sm:block">
                  <img
                    src={p.image}
                    alt={p.title}
                    class="w-full h-full object-cover group-hover/row:scale-105 transition-transform duration-200"
                    loading="lazy"
                  />
                </div>
                <div class="space-y-0.5 min-w-0">
                  <div class="text-sm font-bold text-text font-sans truncate">{p.title}</div>
                  <div class="text-[11px] text-text-muted truncate">{p.category} · {p.role} ({p.year})</div>
                </div>
              </div>

              <div class="flex items-center gap-3">
                <div class="hidden md:flex items-center gap-1.5">
                  {p.stack.slice(0, 3).map((st) => (
                    <span class="text-[10px] px-2 py-0.5 rounded bg-surface-2 border border-border text-text-muted">
                      {st}
                    </span>
                  ))}
                </div>
                <a
                  href={`/work/${p.slug}`}
                  class="text-text hover:underline shrink-0 text-xs inline-flex items-center gap-1 font-mono"
                >
                  Deep dive →
                </a>
                {p.liveUrl ? (
                  <a
                    href={p.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-text font-bold hover:underline shrink-0 text-xs inline-flex items-center gap-1"
                  >
                    Visit ↗
                  </a>
                ) : p.repoUrl ? (
                  <a
                    href={p.repoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-text font-bold hover:underline shrink-0 text-xs inline-flex items-center gap-1"
                  >
                    GitHub ↗
                  </a>
                ) : (
                  <span class="text-text-faint text-[11px]">Private Client</span>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </Reveal>
  </div>
</section>
