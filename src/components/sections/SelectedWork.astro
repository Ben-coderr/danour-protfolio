---
import { projects as rawProjects } from '../../data/projects';
import { getLocalizedProject } from '../../i18n/projects.ar';
import { useTranslations, type Locale } from '../../i18n/ui';
import Button from '../ui/Button.astro';

interface Props {
  locale?: Locale;
}

const {
  locale = (Astro.currentLocale as Locale) || (Astro.url.pathname.startsWith('/ar') ? 'ar' : 'en'),
} = Astro.props;

const t = useTranslations(locale);
const basePrefix = locale === 'ar' ? '/ar' : '';

const localizedProjects = rawProjects.map((p) => getLocalizedProject(p, locale));
const flagshipProjects = localizedProjects.filter((p) =>
  ['jg-supply-net', 'phytosense', 'vyro', 'new-way'].includes(p.slug)
);
---

<section id="work" class="py-20 md:py-28 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 md:px-12 space-y-16">
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6">
      <div class="space-y-3">
        <h2 class="text-headline text-text">
          {locale === 'ar' ? 'معماريات برمجية ومشاريع مختارة' : 'Selected Production Architectures'}
        </h2>
        <p class="text-body text-text-muted max-prose">
          {
            locale === 'ar'
              ? 'أنظمة برمجية مصممة للعمل في بيئات الإنتاج الحقيقية: معالجة زمن الاستجابة، بوابات الدفع الوطنية، وتطبيقات الذكاء الاصطناعي متعددة النماذج.'
              : 'Production systems engineered for real-world resilience: low-latency edge compute, Algerian domestic payment pipelines, and multi-model AI architectures.'
          }
        </p>
      </div>

      <Button href={`${basePrefix}/work`} variant="secondary" size="md">
        {t('section.01.archive')}
      </Button>
    </div>

    <!-- Featured Projects Grid -->
    <div class="space-y-20">
      {
        flagshipProjects.map((project, idx) => {
          const [shortTitle, ...taglineParts] = project.title.split(' — ');
          const projectTagline = taglineParts.join(' — ');
          return (
            <article class="bg-surface rounded-lg p-6 sm:p-8 lg:p-10 space-y-8" data-reveal>
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
                <!-- Left / Top: Project Details -->
                <div class="lg:col-span-6 space-y-4">
                  <h3 class="text-2xl sm:text-3xl font-bold text-text tracking-tight">
                    {shortTitle}
                  </h3>

                  <div class="flex flex-wrap items-center gap-2.5 text-small text-text-muted">
                    {projectTagline && (
                      <>
                        <span class="text-text font-medium">{projectTagline}</span>
                        <span>·</span>
                      </>
                    )}
                    <span class="text-text font-semibold">{project.year}</span>
                    <span>·</span>
                    <span>{project.role}</span>
                  </div>

                  <p class="text-body text-text-muted leading-relaxed max-prose">
                    {project.summary}
                  </p>

                  <!-- Stack Pills -->
                  <div class="flex flex-wrap gap-2 pt-1">
                    {project.stack.slice(0, 5).map((tech) => (
                      <span class="text-small px-3 py-1 rounded bg-surface-2 text-text">
                        {tech}
                      </span>
                    ))}
                  </div>

                  <!-- Actions -->
                  <div class="flex flex-wrap items-center gap-4 pt-3">
                    <Button href={`${basePrefix}/work/${project.slug}`} variant="primary" size="md">
                      {locale === 'ar' ? 'دراسة المعمارية الكاملة' : 'Read Architecture Case Study'}
                    </Button>
                    {project.liveUrl && (
                      <Button href={project.liveUrl} variant="ghost" size="md" target="_blank" rel="noopener noreferrer">
                        {locale === 'ar' ? 'معاينة المنصة الحية' : 'Visit Live Platform'}
                      </Button>
                    )}
                  </div>
                </div>

                <!-- Right: Real Image Architecture View -->
                <div class="lg:col-span-6">
                  <div class="rounded-lg overflow-hidden bg-surface-2 aspect-16/10">
                    <img
                      src={project.image}
                      alt={project.title}
                      class="w-full h-full object-cover transition-transform duration-300 hover:scale-[1.02]"
                      loading={idx === 0 ? 'eager' : 'lazy'}
                      width="800"
                      height="500"
                    />
                  </div>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
