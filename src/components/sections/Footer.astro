---
import { siteConfig } from '../../data/site';
import { useTranslations, type Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const {
  locale = (Astro.currentLocale as Locale) || (Astro.url.pathname.startsWith('/ar') ? 'ar' : 'en'),
} = Astro.props;

const t = useTranslations(locale);
const basePrefix = locale === 'ar' ? '/ar' : '';
const homeUrl = locale === 'ar' ? '/ar' : '/';
const currentYear = new Date().getFullYear();

const navItems = [
  { label: t('nav.work'), href: `${basePrefix}/work` },
  { label: t('nav.teaching'), href: `${basePrefix}/teaching` },
  { label: t('nav.about'), href: `${basePrefix}/about` },
  { label: t('nav.experience'), href: `${homeUrl}#experience` },
  { label: t('nav.contact'), href: `${homeUrl}#contact` },
];
---

<footer class="w-full bg-surface-2 text-text pt-20 pb-12 mt-20">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 md:px-12 space-y-16">
    <!-- Monumental Close Name -->
    <div
      class="text-monument text-text tracking-tighter opacity-15 select-none leading-none -ml-1 rtl:-ml-0 rtl:-mr-1"
      aria-hidden="true"
    >
      ABDENOUR
    </div>

    <!-- Navigation & Metadata Row -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pt-4">
      <!-- Col 1: Identity & Description -->
      <div class="md:col-span-5 space-y-3">
        <div class="text-lg font-bold text-text">{siteConfig.name}</div>
        <p class="text-small text-text-muted leading-relaxed max-w-sm">
          {
            locale === 'ar'
              ? 'مهندس برمجيات ومدرب ذكاء اصطناعي ومؤسس منصة BenCoder. مستغانم، الجزائر.'
              : 'AI Instructor, Full-Stack Engineer, and Creator behind BenCoder. Mostaganem, Algeria.'
          }
        </p>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="md:col-span-4 space-y-3">
        <div class="text-small font-semibold text-text">Navigation</div>
        <div class="flex flex-wrap gap-x-6 gap-y-2 text-small">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class="text-text-muted hover:text-text transition-colors duration-150"
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </div>

      <!-- Col 3: Social & External -->
      <div class="md:col-span-3 space-y-3">
        <div class="text-small font-semibold text-text">Platforms</div>
        <div class="flex flex-col gap-1.5 text-small">
          <a
            href={siteConfig.socials.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="text-text-muted hover:text-text transition-colors duration-150"
          >
            LinkedIn
          </a>
          <a
            href={siteConfig.socials.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="text-text-muted hover:text-text transition-colors duration-150"
          >
            Instagram (102K+)
          </a>
          <a
            href={siteConfig.socials.github}
            target="_blank"
            rel="noopener noreferrer"
            class="text-text-muted hover:text-text transition-colors duration-150"
          >
            GitHub
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Credits & Legal -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-small text-text-muted">
      <div>
        © {currentYear} {siteConfig.name}. {locale === 'ar' ? 'كافة الحقوق محفوظة.' : 'All rights reserved.'}
      </div>
      <div class="text-small text-text-muted">
        Video atmosphere: "Night views over the Mediterranean Sea" by ISS Expedition 29, public domain (Wikimedia Commons).
      </div>
    </div>
  </div>
</footer>
