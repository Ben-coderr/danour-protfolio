---
import SectionLabel from '../ui/SectionLabel.astro';
import { CopyEmailButton } from '../islands/CopyEmailButton';
import { ContactForm } from '../islands/ContactForm';
import { siteConfig } from '../../data/site';
import Reveal from '../ui/Reveal.astro';
---

<section id="contact" class="py-20 md:py-28 scroll-mt-20">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
    <!-- Header -->
    <div class="border-b border-border pb-8">
      <SectionLabel number="06" label="LET'S CONNECT" />
      <h2 class="text-headline text-text mt-3 max-w-3xl">
        Have a course to teach, a product to build, or a team that needs <span class="font-accent">AI skills?</span>
      </h2>
      <p class="text-text-muted text-base max-w-xl mt-2 leading-relaxed">
        I'm open to AI instructor roles, workshops, full-stack freelance contracts, and AI engineering internships.
      </p>
    </div>

    <!-- Contact Grid: Left Links & Fast Copy / Right Interactive Form -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <!-- Left 5 Cols: Quick Inquiries & Direct Channels -->
      <div class="lg:col-span-5 space-y-8">
        <Reveal delay={0}>
          <div class="space-y-4">
            <h3 class="text-lg font-bold text-text">Direct Inquiries</h3>
            <p class="text-sm text-text-muted leading-relaxed">
              Prefer writing an email directly? Copy my address with a single click or open your default mail client.
            </p>

            <div class="pt-1">
              <CopyEmailButton client:load email={siteConfig.email} />
            </div>
          </div>
        </Reveal>

        <Reveal delay={100}>
          <div class="space-y-4 pt-6 border-t border-border">
            <div class="font-mono text-xs uppercase tracking-wider text-text-faint">Professional Profiles</div>

            <div class="space-y-2">
              <a
                href={siteConfig.socials.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between p-3.5 rounded-xl border border-border bg-surface hover:border-border-strong transition-colors group"
              >
                <div class="flex items-center gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-text-muted group-hover:text-text">
                    <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                    <rect width="4" height="12" x="2" y="9"></rect>
                    <circle cx="4" cy="4" r="2"></circle>
                  </svg>
                  <span class="text-sm font-medium text-text">LinkedIn Profile</span>
                </div>
                <span class="font-mono text-xs text-text-faint group-hover:text-text">/in/danour ↗</span>
              </a>

              <a
                href={siteConfig.socials.github}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between p-3.5 rounded-xl border border-border bg-surface hover:border-border-strong transition-colors group"
              >
                <div class="flex items-center gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-text-muted group-hover:text-text">
                    <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
                    <path d="M9 18c-4.51 2-5-2-7-2"></path>
                  </svg>
                  <span class="text-sm font-medium text-text">GitHub Profile</span>
                </div>
                <span class="font-mono text-xs text-text-faint group-hover:text-text">@Ben-coderr ↗</span>
              </a>

              <a
                href="/Abdenour_Benkorich_CV.pdf"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between p-3.5 rounded-xl border border-border bg-surface hover:border-border-strong transition-colors group"
              >
                <div class="flex items-center gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-text-muted group-hover:text-text">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                  </svg>
                  <span class="text-sm font-medium text-text">Curriculum Vitae</span>
                </div>
                <span class="font-mono text-xs text-text-faint group-hover:text-text">PDF Document ↗</span>
              </a>
            </div>
          </div>
        </Reveal>

        <Reveal delay={150}>
          <div class="p-4 rounded-xl border border-border bg-surface-2 text-xs font-mono text-text-muted space-y-1">
            <div class="text-text font-semibold">Location &amp; Availability:</div>
            <div>Mostaganem, Algeria · UTC+1 (Remote-friendly worldwide)</div>
            <div class="text-text-faint pt-1">Phone number provided privately upon initial inquiry.</div>
          </div>
        </Reveal>
      </div>

      <!-- Right 7 Cols: Contact Form -->
      <div class="lg:col-span-7">
        <Reveal delay={100}>
          <div class="p-6 sm:p-8 rounded-[14px] border border-border bg-surface shadow-xs space-y-5">
            <div>
              <h3 class="text-xl font-bold text-text">Send a Message</h3>
              <p class="text-xs text-text-muted mt-1">
                Fill out the form below and I will get back to you within 48 hours.
              </p>
            </div>

            <ContactForm client:load />
          </div>
        </Reveal>
      </div>
    </div>
  </div>
</section>
