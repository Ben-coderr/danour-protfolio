---
import { CopyEmailButton } from '../islands/CopyEmailButton';
import Button from '../ui/Button.astro';
import { siteConfig } from '../../data/site';
import type { Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const {
  locale = (Astro.currentLocale as Locale) || (Astro.url.pathname.startsWith('/ar') ? 'ar' : 'en'),
} = Astro.props;

const socialLinks = [
  { name: 'LinkedIn', url: siteConfig.socials.linkedin, handle: 'in/danour' },
  { name: 'Instagram', url: siteConfig.socials.instagram, handle: '@ben.coderr (102K+)' },
  { name: 'GitHub', url: siteConfig.socials.github, handle: 'Ben-coderr' },
  { name: 'Udemy', url: siteConfig.socials.udemy, handle: 'Python in Arabic (4.8 rating)' },
];
---

<section id="contact" class="py-20 md:py-28 bg-surface-2 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 md:px-12 space-y-16">
    <!-- Header -->
    <div class="space-y-3 pb-4">
      <h2 class="text-headline text-text">
        {locale === 'ar' ? 'لنبنِ أو نعلّم معاً' : "Let's Build or Teach Together"}
      </h2>
      <p class="text-body text-text-muted max-prose">
        {
          locale === 'ar'
            ? 'سواء كنت ترغب في تصميم مساق تدريبي في الذكاء الاصطناعي، بناء منتج برمجي، أو استشارة معمارية، يمكنك التواصل المباشر عبر البريد الإلكتروني.'
            : 'Whether you are planning an AI curriculum, launching a software product, or seeking architectural guidance, write to me directly.'
        }
      </p>
    </div>

    <!-- The Email as Display Type -->
    <div class="bg-surface rounded-lg p-8 sm:p-12 lg:p-16 space-y-10" data-reveal>
      <div class="space-y-3">
        <a
          href={`mailto:${siteConfig.email}`}
          class="block text-2xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-text hover:text-text-muted transition-colors break-all leading-tight"
        >
          {siteConfig.email}
        </a>
        <p class="text-body text-text-muted pt-1">
          {locale === 'ar' ? 'الرد النموذجي خلال 24 ساعة · مستغانم، الجزائر (UTC+1)' : 'Typical response within 24 hours · Mostaganem, Algeria (UTC+1)'}
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-4 pt-2">
        <Button href={`mailto:${siteConfig.email}`} variant="primary" size="lg">
          {locale === 'ar' ? 'إرسال بريد إلكتروني مباشر' : 'Send an Email'}
        </Button>
        <CopyEmailButton client:load email={siteConfig.email} />
      </div>

      <!-- Professional Channels -->
      <div class="pt-6 space-y-4">
        <div class="text-small text-text font-semibold">
          {locale === 'ar' ? 'الملفات المهنية والمنصات' : 'Verified Profiles & Communities'}
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {
            socialLinks.map((item) => (
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="p-4 rounded-md bg-surface-2 hover:bg-surface text-text transition-colors duration-150 block space-y-1"
              >
                <div class="text-small font-semibold text-text">{item.name}</div>
                <div class="text-small text-text-muted">{item.handle}</div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
