---
import SectionLabel from '../ui/SectionLabel.astro';
import { CopyEmailButton } from '../islands/CopyEmailButton';
import { ContactForm } from '../islands/ContactForm';
import { LocalClock } from '../islands/LocalClock';
import { siteConfig } from '../../data/site';
import Reveal from '../ui/Reveal.astro';
import { useTranslations, type Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const {
  locale = (Astro.currentLocale as Locale) || (Astro.url.pathname.startsWith('/ar') ? 'ar' : 'en'),
} = Astro.props;

const t = useTranslations(locale);
---

<section id="contact" class="py-20 md:py-28 scroll-mt-20 relative">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
    <!-- Header -->
    <div class="border-b border-border pb-8">
      <SectionLabel number={t('section.06.num')} label={locale === 'ar' ? 'التواصل والتعاون' : "LET'S CONNECT"} />
      <h2 class="text-headline text-text mt-3 max-w-3xl">
        {locale === 'ar' ? (
          <>
            هل لديك مساق تريد تدريسه، منتج ترغب ببنائه، أو فريق يحتاج <span class="font-accent">مهارات الذكاء الاصطناعي؟</span>
          </>
        ) : (
          <>
            Have a course to teach, a product to build, or a team that needs <span class="font-accent">AI skills?</span>
          </>
        )}
      </h2>
      <p class="text-text-muted text-base max-w-xl mt-2 leading-relaxed">
        {t('section.06.description')}
      </p>
    </div>

    <!-- Contact Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <!-- Left 5 Cols: Quick Inquiries & Direct Channels -->
      <div class="lg:col-span-5 space-y-8">
        <Reveal delay={0}>
          <div class="space-y-4">
            <h3 class="text-lg font-bold text-text">
              {locale === 'ar' ? 'الاستفسارات المباشرة' : 'Direct Inquiries'}
            </h3>
            <p class="text-sm text-text-muted leading-relaxed">
              {locale === 'ar'
                ? 'تفضل المراسلة المباشرة عبر البريد الإلكتروني؟ انسخ عنوان البريد بنقرة واحدة أو افتح تطبيق البريد المفضل لديك.'
                : 'Prefer writing an email directly? Copy my address with a single click or open your default mail client.'}
            </p>

            <div class="pt-1">
              <CopyEmailButton client:load email={siteConfig.email} />
            </div>
          </div>
        </Reveal>

        <Reveal delay={100}>
          <div class="space-y-4 pt-6 border-t border-border">
            <div class="font-mono text-xs uppercase tracking-wider text-text-faint">
              {locale === 'ar' ? 'الحسابات المهنية والملفات' : 'Professional Profiles'}
            </div>

            <div class="space-y-2">
              <a
                href={siteConfig.socials.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between p-3.5 rounded-xl border border-border bg-surface hover:border-border-strong transition-colors group"
              >
                <div class="flex items-center gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-text-muted group-hover:text-text">
                    <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                    <rect width="4" height="12" x="2" y="9"></rect>
                    <circle cx="4" cy="4" r="2"></circle>
                  </svg>
                  <span class="text-sm font-medium text-text">
                    {locale === 'ar' ? 'الملف الشخصي على LinkedIn' : 'LinkedIn Profile'}
                  </span>
                </div>
                <span class="font-mono text-xs text-text-faint group-hover:text-text bidi-tech">/in/danour ↗</span>
              </a>

              <a
                href={siteConfig.socials.github}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between p-3.5 rounded-xl border border-border bg-surface hover:border-border-strong transition-colors group"
              >
                <div class="flex items-center gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-text-muted group-hover:text-text">
                    <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
                    <path d="M9 18c-4.51 2-5-2-7-2"></path>
                  </svg>
                  <span class="text-sm font-medium text-text">
                    {locale === 'ar' ? 'الحساب على GitHub' : 'GitHub Profile'}
                  </span>
                </div>
                <span class="font-mono text-xs text-text-faint group-hover:text-text bidi-tech">@Ben-coderr ↗</span>
              </a>

              <a
                href="/Abdenour_Benkorich_CV.pdf"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between p-3.5 rounded-xl border border-border bg-surface hover:border-border-strong transition-colors group"
              >
                <div class="flex items-center gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-text-muted group-hover:text-text">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                  </svg>
                  <span class="text-sm font-medium text-text">
                    {locale === 'ar' ? 'السيرة الذاتية المفصلة' : 'Curriculum Vitae'}
                  </span>
                </div>
                <span class="font-mono text-xs text-text-faint group-hover:text-text">
                  {locale === 'ar' ? 'ملف PDF ↗' : 'PDF Document ↗'}
                </span>
              </a>
            </div>
          </div>
        </Reveal>

        <!-- Live Clock & Status Callout -->
        <Reveal delay={150}>
          <div class="p-4 rounded-xl border border-border bg-surface-2 text-xs font-mono space-y-2">
            <div class="flex items-center justify-between pb-2 border-b border-border/60">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-status"></span>
                <span class="text-text font-bold uppercase tracking-wider">
                  {locale === 'ar' ? 'توقيت مستغانم' : 'Mostaganem Time'}
                </span>
              </div>
              <LocalClock client:load />
            </div>
            <div class="text-text-muted text-[11px] leading-relaxed">
              {locale === 'ar'
                ? 'مقيم في مستغانم، الجزائر · أعمل دولياً بالعربية، الإنجليزية والفرنسية عبر مختلف النطاقات الزمنية.'
                : 'Based in Mostaganem, Algeria · Operating globally in English, Arabic, and French across European and American timezones.'}
            </div>
          </div>
        </Reveal>
      </div>

      <!-- Right 7 Cols: Interactive Contact Form -->
      <div class="lg:col-span-7">
        <Reveal delay={100}>
          <div class="rounded-2xl border border-border-strong bg-surface p-6 sm:p-8 lg:p-10 shadow-sm space-y-6">
            <div class="space-y-1">
              <h3 class="text-xl sm:text-2xl font-bold text-text tracking-tight font-sans">
                {locale === 'ar' ? 'إرسال رسالة' : 'Send a Message'}
              </h3>
              <p class="text-xs sm:text-sm text-text-muted">
                {locale === 'ar'
                  ? 'يتم الرد على كافة الاستفسارات خلال 24 ساعة كحد أقصى.'
                  : 'Inquiries typically receive a response within 24 hours.'}
              </p>
            </div>

            <ContactForm client:visible />
          </div>
        </Reveal>
      </div>
    </div>
  </div>
</section>
