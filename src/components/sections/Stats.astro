---
import Reveal from '../ui/Reveal.astro';
import type { Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const {
  locale = (Astro.currentLocale as Locale) || (Astro.url.pathname.startsWith('/ar') ? 'ar' : 'en'),
} = Astro.props;

const statsData =
  locale === 'ar'
    ? [
        {
          num: '01',
          label: 'المجتمع والوصول',
          value: '102K+',
          metric: 'متابع',
          sub: 'مجتمع برمجي متفاعل وواسع عبر منصات وقنوات BenCoder',
          badge: 'مجتمع 102K+',
        },
        {
          num: '02',
          label: 'معسكر الذكاء الاصطناعي',
          value: '20+',
          metric: 'مهندس',
          sub: 'خريجون تدربوا تطبيقياً في معسكر "Build with AI" المكثف',
          badge: 'Everest Academy',
        },
        {
          num: '03',
          label: 'الأكاديمية الرقمية',
          value: '300+',
          metric: 'طالب',
          sub: 'دورة بايثون للمبتدئين بالعربية على Udemy · تقييم متميز 4.8★',
          badge: 'Udemy 4.8★',
        },
        {
          num: '04',
          label: 'المحتوى التطبيقي',
          value: '45+',
          metric: 'شرح',
          sub: 'شروحات عملية مرئية باللغة العربية في الذكاء الاصطناعي وهندسة الويب',
          badge: 'منصة BenCoder',
        },
      ]
    : [
        {
          num: '01',
          label: 'Community & Reach',
          value: '102K+',
          metric: 'Followers',
          sub: 'Engaged developer community across BenCoder platforms',
          badge: '102K+ Devs',
        },
        {
          num: '02',
          label: 'AI Bootcamp',
          value: '20+',
          metric: 'Engineers',
          sub: 'Graduates trained hands-on in "Build with AI" intensive bootcamp',
          badge: 'Everest Academy',
        },
        {
          num: '03',
          label: 'Online Academy',
          value: '300+',
          metric: 'Students',
          sub: 'Python for Beginners in Arabic on Udemy · 4.8★ student rating',
          badge: 'Udemy 4.8★',
        },
        {
          num: '04',
          label: 'Technical Content',
          value: '45+',
          metric: 'Tutorials',
          sub: 'Hands-on Arabic video breakdowns in applied AI & web architecture',
          badge: 'BenCoder Media',
        },
      ];
---

<section class="border-y border-border/80 bg-surface/30 backdrop-blur-xs relative overflow-hidden">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 sm:divide-x rtl:divide-x-reverse divide-border/70 border-x border-border/50"
    >
      {
        statsData.map((stat, idx) => (
          <Reveal delay={idx * 75}>
            <div class="p-6 sm:p-7 lg:p-8 flex flex-col justify-between h-full group hover:bg-surface/60 transition-colors duration-200">
              {/* Header Row: Index & Category */}
              <div class="flex items-center justify-between pb-3 text-xs font-mono">
                <span class="text-text-faint group-hover:text-text transition-colors flex items-center gap-1.5">
                  <span class="bidi-tech font-bold text-text-faint">{stat.num}</span>
                  <span class="text-border-strong">·</span>
                  <span class="text-text-muted">{stat.label}</span>
                </span>
                <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded bg-surface-2 border border-border text-text-muted group-hover:text-text group-hover:border-border-strong transition-colors">
                  {stat.badge}
                </span>
              </div>

              {/* Value Display */}
              <div class="my-4">
                <div class="flex items-baseline gap-2">
                  <span class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-text font-sans bidi-tech">
                    {stat.value}
                  </span>
                  <span class="text-xs font-mono text-text-faint uppercase tracking-wider">
                    {stat.metric}
                  </span>
                </div>
              </div>

              {/* Subtitle */}
              <p class="text-xs text-text-muted leading-relaxed">{stat.sub}</p>
            </div>
          </Reveal>
        ))
      }
    </div>
  </div>
</section>
