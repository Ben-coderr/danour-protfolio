---
import { siteConfig } from '../../data/site';
import Card from '../ui/Card.astro';
import Reveal from '../ui/Reveal.astro';
---

<section class="py-10 border-y border-border/80 bg-surface/40">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {siteConfig.stats.map((stat, idx) => (
        <Reveal delay={idx * 80}>
          <Card padding="md" class="h-full flex flex-col justify-between">
            <div class="text-xs uppercase font-mono tracking-wider text-text-faint">
              {stat.label}
            </div>
            <div class="my-2">
              <span class="text-2xl sm:text-3xl font-bold tracking-tight text-text">
                {stat.value}
              </span>
            </div>
            <div class="text-xs text-text-muted leading-relaxed">
              {stat.sub}
            </div>
          </Card>
        </Reveal>
      ))}
    </div>
  </div>
</section>
