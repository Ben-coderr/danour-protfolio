---
import type { Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const {
  locale = (Astro.currentLocale as Locale) || (Astro.url.pathname.startsWith('/ar') ? 'ar' : 'en'),
} = Astro.props;

const stats =
  locale === 'ar'
    ? [
        {
          value: '102K+',
          label: 'مجتمع BenCoder البرمجي',
          desc: 'مطوّر ومهندس يتعلمون البرمجة والذكاء الاصطناعي أسبوعياً (تأسس 2022)',
        },
        {
          value: 'كبير المدربين',
          label: 'Everest Academy',
          desc: 'قيادة معسكر "Build with AI" المكثف لتدريب مهندسي الجيل القادم',
        },
        {
          value: '300+ طالب',
          label: 'دورة بايثون العربية',
          desc: 'تقييم 4.8 على منصة Udemy من المبادئ البرمجية إلى OOP المتقدم',
        },
        {
          value: '2026',
          label: 'مهندس دولة في الإعلام الآلي',
          desc: 'تخصص علوم البيانات وهندسة النظم الذكية بجامعة عبد الحميد بن باديس',
        },
      ]
    : [
        {
          value: '102K+',
          label: 'BenCoder Community',
          desc: 'Developers learning software and applied AI weekly (founded 2022)',
        },
        {
          value: 'Lead Instructor',
          label: 'Everest Academy',
          desc: 'Spearheading the intensive "Build with AI" production bootcamp',
        },
        {
          value: '300+ Students',
          label: 'Udemy Python Course',
          desc: 'Rated 4.8 across algorithmic fundamentals to object-oriented programming',
        },
        {
          value: '2026',
          label: 'State Engineering Degree',
          desc: 'Computer Engineering & Data Science @ Universite Abdelhamid Ibn Badis',
        },
      ];
---

<section class="py-16 md:py-24 bg-surface-2">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 md:px-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">
      {
        stats.map((item) => (
          <div class="space-y-2" data-reveal>
            <div class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-text leading-none">
              {item.value}
            </div>
            <div class="text-body font-semibold text-text pt-1">{item.label}</div>
            <p class="text-body text-text-muted leading-relaxed max-w-xs">{item.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
