---
import SectionLabel from '../ui/SectionLabel.astro';
import TagList from '../ui/TagList.astro';
import Reveal from '../ui/Reveal.astro';

const timeline = [
  {
    role: 'Lead Architect & Full-Stack Engineer',
    company: 'JG SupplyNet (Jamael Group)',
    period: '2025 — Present',
    status: 'active',
    location: 'Algeria',
    category: 'B2B Digital Platform',
    summary: 'Architected and shipped Algeria’s premier B2B procurement network (jgsupplynet.com), connecting verified national manufacturers, industrial suppliers, and corporate buyers with RFQ workflows and multilingual interfaces.',
    achievements: [
      'Engineered resilient full-stack architecture with Next.js 15 App Router, TypeScript, and high-performance serverless endpoints.',
      'Implemented trilingual localization (EN / FR / AR) with automated multi-currency industrial quote generation.',
      'Designed responsive enterprise catalog navigation with instant faceted search and high mobile conversion.',
    ],
    stack: ['Next.js 15', 'TypeScript', 'Tailwind CSS', 'Vercel', 'PostgreSQL'],
  },
  {
    role: 'Lead AI Instructor ("Build with AI")',
    company: 'Everest Academy',
    period: '2026',
    status: 'active',
    location: 'Mostaganem, Algeria',
    category: 'GenAI Intensive Formation',
    summary: 'Designed and instructed intensive generative AI formation covering prompt engineering, vibe coding, AI video synthesis, and commercial AI graphic design for production-grade output.',
    achievements: [
      'Taught advanced prompt engineering, context framing, and system prompt architectures.',
      'Pioneered Vibe Coding methodology to rapidly prototype and iterate full-stack web applications using AI copilots.',
      'Taught AI video generation (Runway, Kling, Luma) and AI graphic design (Midjourney, FLUX.1) for commercial creative workflows.',
      '100% of students shipped functional AI prototypes for graduation demo day.',
    ],
    stack: ['Prompt Engineering', 'Vibe Coding', 'AI Video', 'FLUX.1', 'Next.js', 'Python'],
  },
  {
    role: 'Embedded Systems & Robotics Mentor',
    company: 'DZDuino Collaboration',
    period: '2026 — Present',
    status: 'active',
    location: 'Algeria',
    category: 'Robotics & Hardware',
    summary: 'Hands-on embedded systems training in collaboration with dzduino.com, mentoring robotics students on Arduino microcontrollers and Raspberry Pi single-board computers.',
    achievements: [
      'Guiding 2 dedicated students through a rigorous 2-month embedded hardware and robotics program (1 month completed, 1 month active).',
      'Taught sensor interfacing, PWM motor actuation, I2C/SPI bus protocols, and real-time C/C++ firmware.',
      'Integrated Raspberry Pi Linux environments with Python for computer vision and IoT edge computing.',
    ],
    stack: ['Arduino', 'Raspberry Pi', 'C/C++', 'Python', 'Sensors', 'dzduino.com'],
  },
  {
    role: 'Course Author & Online Instructor',
    company: 'Udemy (BenCoder)',
    period: '2024 — Present',
    status: 'active',
    location: 'Online / Global',
    category: '300+ Students',
    summary: 'Author of "Python for Beginners in Arabic" (تعلم البرمجة من الصفر بلغة بايثون), my premier online course with 300+ enrolled students building strong algorithmic and software foundations.',
    achievements: [
      'Designed complete Arabic curriculum from zero programming knowledge to object-oriented programming and practical projects.',
      'Maintained outstanding student rating with active mentoring and code review in course forums.',
    ],
    stack: ['Python', 'Curriculum Design', 'Algorithmic Thinking', 'Udemy'],
  },
  {
    role: 'Technical Creator & Founder',
    company: 'BenCoder',
    period: '2024 — Present',
    status: 'active',
    location: 'Global (Online)',
    category: '102K+ Community',
    summary: 'Create Arabic technical tutorials and AI guides breaking down modern web frameworks, agent architectures, and programming fundamentals for a 102,000+ Arabic-speaking developer community.',
    achievements: [
      'Produced 45+ video and practical engineering breakdowns in Arabic with zero fluff.',
      'Grew an engaged technical audience of over 102,000 Arabic developers across Algeria and the Arab region.',
      'Organized weekly Q&A sessions on AI career transitions and software best practices.',
    ],
    stack: ['Content Creation', 'Next.js', 'Python', 'Web Architecture', 'Community'],
  },
  {
    role: 'Technical Speaker & Workshop Instructor',
    company: 'University & Tech Hubs',
    period: '2025 — 2026',
    status: 'milestone',
    location: 'Tlemcen, Algiers & Oran, Algeria',
    category: 'Multi-City Workshops',
    summary: 'Delivered hands-on software development bootcamps, algorithmic seminars, and web engineering workshops across university hubs in Tlemcen, Algiers, and Oran.',
    achievements: [
      'Led intensive 3-month 1-on-1 Summer web development mentorship, advancing an individual from fundamentals to full-stack proficiency.',
      'Conducted algorithmic problem solving, modern JavaScript/TypeScript, and web architecture workshops.',
      'Mentored university engineering students on technical portfolio development and career transitions.',
    ],
    stack: ['Web Dev Mentorship', 'JavaScript', 'Algorithms', 'Tlemcen', 'Algiers', 'Oran'],
  },
  {
    role: 'Software Engineer Intern',
    company: 'Sonatrach GP1Z',
    period: 'June 2026',
    status: 'internship',
    location: 'Algeria',
    category: 'Industrial Enterprise',
    summary: 'National petroleum enterprise. Worked on internal software systems, technical documentation, and IT infrastructure operations within a critical national facility.',
    achievements: [
      'Analyzed server maintenance workflows and network monitoring configurations.',
      'Supported internal enterprise system tasks in a high-security operational environment.',
    ],
    stack: ['Linux', 'Windows Server', 'Networks', 'IT Systems', 'Enterprise Security'],
  },
  {
    role: 'Backend Developer Intern',
    company: 'Sefrone',
    period: 'Dec 2024 — Mar 2025',
    status: 'internship',
    location: 'Algeria',
    category: 'Startup Internship',
    summary: 'Engineered REST APIs and relational database schemas for client web applications in an agile, fast-paced product team.',
    achievements: [
      'Engineered scalable Node.js backend endpoints with PostgreSQL data persistence.',
      'Optimized query performance and reduced API response latencies.',
      'Participated in daily standups, code reviews, and Git feature branches.',
    ],
    stack: ['Node.js', 'PostgreSQL', 'REST APIs', 'Git', 'Agile'],
  },
];
---

<section id="experience" class="py-20 md:py-28 scroll-mt-20 relative">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
    <!-- Header -->
    <div class="border-b border-border pb-8 flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div class="space-y-3">
        <SectionLabel number="05" label="EXPERIENCE &amp; EDUCATION" />
        <h2 class="text-headline text-text">
          Where I've <span class="font-accent">contributed</span> &amp; learned
        </h2>
        <p class="text-text-muted text-base max-w-xl leading-relaxed">
          From national enterprise infrastructure to fast-moving AI research and technical education leadership.
        </p>
      </div>

      <div class="font-mono text-xs text-text-faint flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-status"></span>
        <span>Engineering Timeline &amp; Roles</span>
      </div>
    </div>

    <!-- Git-Commit Spine Timeline (No Boxy Card Repetition) -->
    <div class="relative pl-6 sm:pl-8 ml-3 sm:ml-4 border-l-2 border-border/80 space-y-12">
      {timeline.slice(0, 4).map((item, idx) => (
        <Reveal delay={idx * 60}>
          <div class="relative group">
            {/* Git node marker */}
            <div
              class={`absolute -left-[31px] sm:-left-[39px] top-1.5 w-4 h-4 rounded-full border-2 border-bg ring-4 ring-bg flex items-center justify-center ${
                item.status === 'active'
                  ? 'bg-status shadow-xs'
                  : 'bg-border-strong group-hover:bg-text transition-colors'
              }`}
              aria-hidden="true"
            >
              {item.status === 'active' && (
                <span class="w-1.5 h-1.5 rounded-full bg-bg"></span>
              )}
            </div>

            <!-- Content Container -->
            <div class="space-y-3">
              <!-- Meta line: Period, Status, Category -->
              <div class="flex flex-wrap items-center gap-2 text-xs font-mono">
                <span class="font-bold text-text bg-surface-2 px-2.5 py-0.5 rounded border border-border">
                  {item.period}
                </span>
                <span class="text-text-faint">·</span>
                <span class="text-text-muted font-medium">{item.category}</span>
                <span class="text-text-faint">·</span>
                <span class="text-text-faint">{item.location}</span>
                {item.status === 'active' && (
                  <span class="text-[10px] text-status font-bold uppercase tracking-wider ml-auto">
                    Active
                  </span>
                )}
              </div>

              <!-- Role & Company -->
              <div class="flex flex-wrap items-baseline gap-2">
                <h3 class="text-xl sm:text-2xl font-bold text-text tracking-tight font-sans">
                  {item.role}
                </h3>
                <span class="text-base text-text-muted font-medium font-sans">
                  @ <strong class="text-text font-semibold">{item.company}</strong>
                </span>
              </div>

              <!-- Summary -->
              <p class="text-sm text-text-muted leading-relaxed max-w-3xl">
                {item.summary}
              </p>

              <!-- Achievements list -->
              <ul class="space-y-1.5 text-xs text-text-muted font-mono pt-1 max-w-3xl">
                {item.achievements.map((ach) => (
                  <li class="flex items-start gap-2">
                    <span class="text-status select-none">›</span>
                    <span class="leading-relaxed">{ach}</span>
                  </li>
                ))}
              </ul>

              <!-- Stack Tags -->
              <div class="pt-2">
                <TagList size="sm" tags={item.stack} />
              </div>
            </div>
          </div>
        </Reveal>
      ))}

      <!-- Expandable Earlier Experiences (Progressive Disclosure) -->
      <div id="extra-experience-section" class="hidden space-y-12 pt-12 border-t border-border/50">
        {timeline.slice(4).map((item) => (
          <div class="relative group">
            {/* Git node marker */}
            <div
              class="absolute -left-[31px] sm:-left-[39px] top-1.5 w-4 h-4 rounded-full border-2 border-bg ring-4 ring-bg flex items-center justify-center bg-border-strong group-hover:bg-text transition-colors"
              aria-hidden="true"
            />

            <!-- Content Container -->
            <div class="space-y-3">
              <!-- Meta line: Period, Status, Category -->
              <div class="flex flex-wrap items-center gap-2 text-xs font-mono">
                <span class="font-bold text-text bg-surface-2 px-2.5 py-0.5 rounded border border-border">
                  {item.period}
                </span>
                <span class="text-text-faint">·</span>
                <span class="text-text-muted font-medium">{item.category}</span>
                <span class="text-text-faint">·</span>
                <span class="text-text-faint">{item.location}</span>
              </div>

              <!-- Role & Company -->
              <div class="flex flex-wrap items-baseline gap-2">
                <h3 class="text-xl sm:text-2xl font-bold text-text tracking-tight font-sans">
                  {item.role}
                </h3>
                <span class="text-base text-text-muted font-medium font-sans">
                  @ <strong class="text-text font-semibold">{item.company}</strong>
                </span>
              </div>

              <!-- Summary -->
              <p class="text-sm text-text-muted leading-relaxed max-w-3xl">
                {item.summary}
              </p>

              <!-- Achievements list -->
              <ul class="space-y-1.5 text-xs text-text-muted font-mono pt-1 max-w-3xl">
                {item.achievements.map((ach) => (
                  <li class="flex items-start gap-2">
                    <span class="text-status select-none">›</span>
                    <span class="leading-relaxed">{ach}</span>
                  </li>
                ))}
              </ul>

              <!-- Stack Tags -->
              <div class="pt-2">
                <TagList size="sm" tags={item.stack} />
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- See More Experience Button -->
      <div class="pt-2">
        <button
          id="toggle-experience-btn"
          type="button"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-border bg-surface hover:bg-surface-2 hover:border-border-strong text-xs font-mono font-medium text-text transition-all duration-200 cursor-pointer shadow-2xs group"
          aria-expanded="false"
        >
          <span class="exp-icon text-status transition-transform duration-200">↓</span>
          <span class="exp-text">See more experience (4 earlier roles &amp; internships)</span>
        </button>
      </div>
    </div>

    <!-- Education & Academic Foundation (Architectural Credential Banner) -->
    <Reveal delay={200}>
      <div class="border-t border-border pt-10">
        <div class="p-6 sm:p-8 rounded-2xl border border-border-strong bg-surface/80 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5">
            <!-- University of Mostaganem Logo -->
            <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-white p-2 border border-border-strong flex items-center justify-center shrink-0 shadow-sm overflow-hidden">
              <img
                src="/brand/univ-mostaganem-logo.png"
                alt="Université Abdelhamid Ibn Badis Mostaganem Logo"
                class="w-full h-full object-contain"
                loading="eager"
                width="80"
                height="80"
              />
            </div>

            <div class="space-y-2">
              <div class="flex items-center gap-2 text-xs font-mono text-text-faint uppercase tracking-wider">
                <span>5-YEAR STATE ENGINEERING PROGRAM // INGÉNIEUR D'ÉTAT</span>
                <span>·</span>
                <span class="text-status font-semibold">5-Year Curriculum</span>
              </div>
              <h3 class="text-xl sm:text-2xl font-bold text-text tracking-tight">
                State Engineering Degree (Ingénieur d'État) — Computer Engineering &amp; Data Science
              </h3>
              <div class="text-xs font-mono text-text-muted">
                Université Abdelhamid Ibn Badis · Mostaganem, Algeria
              </div>
              <p class="text-xs sm:text-sm text-text-muted max-w-2xl leading-relaxed pt-1">
                Rigorous 5-year Algerian state engineering curriculum (Diplôme d'Ingénieur d'État) combining integrated preparatory engineering studies, advanced algorithmic complexity, statistical machine learning, database internals, and distributed systems architecture.
              </p>
            </div>
          </div>

          <div class="flex flex-col items-start md:items-end gap-2 shrink-0 font-mono text-xs">
            <span class="px-3 py-1 rounded-full bg-surface-2 border border-border text-text font-medium">
              Engineering Student (Ingénieur d'État)
            </span>
            <span class="text-text-faint text-[11px]">5-Year State Program</span>
          </div>
        </div>
      </div>
    </Reveal>
  </div>
</section>

<script>
  function setupExperienceToggle() {
    const btn = document.getElementById('toggle-experience-btn');
    const extra = document.getElementById('extra-experience-section');
    if (!btn || !extra) return;

    btn.addEventListener('click', () => {
      const isHidden = extra.classList.contains('hidden');
      if (isHidden) {
        extra.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
        const textSpan = btn.querySelector('.exp-text');
        const iconSpan = btn.querySelector('.exp-icon');
        if (textSpan) textSpan.textContent = 'Show less experience';
        if (iconSpan) iconSpan.textContent = '↑';
      } else {
        extra.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        const textSpan = btn.querySelector('.exp-text');
        const iconSpan = btn.querySelector('.exp-icon');
        if (textSpan) textSpan.textContent = 'See more experience (4 earlier roles & internships)';
        if (iconSpan) iconSpan.textContent = '↓';
        btn.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
  }

  setupExperienceToggle();
  document.addEventListener('astro:page-load', setupExperienceToggle);
</script>
