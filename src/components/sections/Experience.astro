---
import SectionLabel from '../ui/SectionLabel.astro';
import TagList from '../ui/TagList.astro';
import Reveal from '../ui/Reveal.astro';
import { getTimeline } from '../../i18n/experience.ar';
import { useTranslations, type Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const {
  locale = (Astro.currentLocale as Locale) || (Astro.url.pathname.startsWith('/ar') ? 'ar' : 'en'),
} = Astro.props;

const t = useTranslations(locale);
const timeline = getTimeline(locale);
---

<section id="experience" class="py-20 md:py-28 scroll-mt-20 relative">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
    <!-- Header -->
    <div class="border-b border-border pb-8 flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div class="space-y-3">
        <SectionLabel number={t('section.05.num')} label={t('section.05.label')} />
        <h2 class="text-headline text-text">
          {t('section.05.title')} <span class="font-accent">{t('section.05.titleAccent')}</span> {t('section.05.titleSuffix')}
        </h2>
        <p class="text-text-muted text-base max-w-xl leading-relaxed">
          {t('section.05.description')}
        </p>
      </div>

      <div class="font-mono text-xs text-text-faint flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-status"></span>
        <span>{locale === 'ar' ? 'المسار الزمني والأدوار الهندسية' : 'Engineering Timeline & Roles'}</span>
      </div>
    </div>

    <!-- Git-Commit Spine Timeline (RTL Mirrored) -->
    <div class="relative pl-6 sm:pl-8 ml-3 sm:ml-4 border-l-2 rtl:border-l-0 rtl:border-r-2 rtl:pl-0 rtl:pr-6 sm:rtl:pr-8 rtl:ml-0 rtl:mr-3 sm:rtl:mr-4 border-border/80 space-y-12">
      {timeline.slice(0, 4).map((item, idx) => (
        <Reveal delay={idx * 60}>
          <div class="relative group">
            {/* Git node marker */}
            <div
              class={`absolute -left-[31px] sm:-left-[39px] rtl:left-auto rtl:-right-[31px] sm:rtl:-right-[39px] top-1.5 w-4 h-4 rounded-full border-2 border-bg ring-4 ring-bg flex items-center justify-center ${
                item.status === 'active'
                  ? 'bg-status shadow-xs'
                  : 'bg-border-strong group-hover:bg-text transition-colors'
              }`}
              aria-hidden="true"
            >
              {item.status === 'active' && (
                <span class="w-1.5 h-1.5 rounded-full bg-bg"></span>
              )}
            </div>

            <!-- Content Container -->
            <div class="space-y-3">
              <!-- Meta line: Period, Status, Category -->
              <div class="flex flex-wrap items-center gap-2 text-xs font-mono">
                <span class="font-bold text-text bg-surface-2 px-2.5 py-0.5 rounded border border-border bidi-tech">
                  {item.period}
                </span>
                <span class="text-text-faint">·</span>
                <span class="text-text-muted font-medium">{item.category}</span>
                <span class="text-text-faint">·</span>
                <span class="text-text-faint">{item.location}</span>
                {item.status === 'active' && (
                  <span class="text-[10px] text-status font-bold uppercase tracking-wider ml-auto rtl:ml-0 rtl:mr-auto">
                    {locale === 'ar' ? 'نشط ومستمر' : 'Active'}
                  </span>
                )}
              </div>

              <!-- Role & Company -->
              <div class="flex flex-wrap items-baseline gap-2">
                <h3 class="text-xl sm:text-2xl font-bold text-text tracking-tight font-sans">
                  {item.role}
                </h3>
                <span class="text-base text-text-muted font-medium font-sans">
                  @ <strong class="text-text font-semibold">{item.company}</strong>
                </span>
              </div>

              <!-- Summary -->
              <p class="text-sm text-text-muted leading-relaxed max-w-3xl">
                {item.summary}
              </p>

              <!-- Achievements list -->
              <ul class="space-y-1.5 text-xs text-text-muted font-mono pt-1 max-w-3xl">
                {item.achievements.map((ach) => (
                  <li class="flex items-start gap-2">
                    <span class="text-status select-none">›</span>
                    <span class="leading-relaxed">{ach}</span>
                  </li>
                ))}
              </ul>

              <!-- Stack Tags -->
              <div class="pt-2">
                <TagList size="sm" tags={item.stack} />
              </div>
            </div>
          </div>
        </Reveal>
      ))}

      <!-- Expandable Earlier Experiences (Progressive Disclosure) -->
      <div id="extra-experience-section" class="hidden space-y-12 pt-12 border-t border-border/50">
        {timeline.slice(4).map((item) => (
          <div class="relative group">
            {/* Git node marker */}
            <div
              class="absolute -left-[31px] sm:-left-[39px] rtl:left-auto rtl:-right-[31px] sm:rtl:-right-[39px] top-1.5 w-4 h-4 rounded-full border-2 border-bg ring-4 ring-bg flex items-center justify-center bg-border-strong group-hover:bg-text transition-colors"
              aria-hidden="true"
            />

            <!-- Content Container -->
            <div class="space-y-3">
              <!-- Meta line: Period, Status, Category -->
              <div class="flex flex-wrap items-center gap-2 text-xs font-mono">
                <span class="font-bold text-text bg-surface-2 px-2.5 py-0.5 rounded border border-border bidi-tech">
                  {item.period}
                </span>
                <span class="text-text-faint">·</span>
                <span class="text-text-muted font-medium">{item.category}</span>
                <span class="text-text-faint">·</span>
                <span class="text-text-faint">{item.location}</span>
              </div>

              <!-- Role & Company -->
              <div class="flex flex-wrap items-baseline gap-2">
                <h3 class="text-xl sm:text-2xl font-bold text-text tracking-tight font-sans">
                  {item.role}
                </h3>
                <span class="text-base text-text-muted font-medium font-sans">
                  @ <strong class="text-text font-semibold">{item.company}</strong>
                </span>
              </div>

              <!-- Summary -->
              <p class="text-sm text-text-muted leading-relaxed max-w-3xl">
                {item.summary}
              </p>

              <!-- Achievements list -->
              <ul class="space-y-1.5 text-xs text-text-muted font-mono pt-1 max-w-3xl">
                {item.achievements.map((ach) => (
                  <li class="flex items-start gap-2">
                    <span class="text-status select-none">›</span>
                    <span class="leading-relaxed">{ach}</span>
                  </li>
                ))}
              </ul>

              <!-- Stack Tags -->
              <div class="pt-2">
                <TagList size="sm" tags={item.stack} />
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- See More Experience Button -->
      <div class="pt-2">
        <button
          id="toggle-experience-btn"
          type="button"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-border bg-surface hover:bg-surface-2 hover:border-border-strong text-xs font-mono font-medium text-text transition-all duration-200 cursor-pointer shadow-2xs group"
          aria-expanded="false"
          data-show-more={t('btn.seeMoreExperience')}
          data-show-less={t('btn.showLessExperience')}
        >
          <span class="exp-icon text-status transition-transform duration-200">↓</span>
          <span class="exp-text">{t('btn.seeMoreExperience')}</span>
        </button>
      </div>
    </div>

    <!-- Education & Academic Foundation (Architectural Credential Banner) -->
    <Reveal delay={200}>
      <div class="border-t border-border pt-10">
        <div class="p-6 sm:p-8 rounded-2xl border border-border-strong bg-surface/80 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5">
            <!-- University of Mostaganem Logo -->
            <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-white p-2 border border-border-strong flex items-center justify-center shrink-0 shadow-sm overflow-hidden">
              <img
                src="/brand/univ-mostaganem-logo.png"
                alt="Université Abdelhamid Ibn Badis Mostaganem Logo"
                class="w-full h-full object-contain"
                loading="eager"
                width="80"
                height="80"
              />
            </div>

            <div class="space-y-2">
              <div class="flex items-center gap-2 text-xs font-mono text-text-faint uppercase tracking-wider">
                <span class="bidi-tech">5-YEAR STATE ENGINEERING // INGÉNIEUR D'ÉTAT</span>
                <span>·</span>
                <span class="text-status font-semibold">{locale === 'ar' ? 'مسار 5 سنوات' : '5-Year Curriculum'}</span>
              </div>
              <h3 class="text-xl sm:text-2xl font-bold text-text tracking-tight">
                {locale === 'ar'
                  ? 'شهادة مهندس دولة (Ingénieur d\'État) — هندسة الإعلام الآلي وعلوم البيانات'
                  : 'State Engineering Degree (Ingénieur d\'État) — Computer Engineering & Data Science'}
              </h3>
              <div class="text-xs font-mono text-text-muted">
                {locale === 'ar'
                  ? 'جامعة عبد الحميد بن باديس · مستغانم، الجزائر'
                  : 'Université Abdelhamid Ibn Badis · Mostaganem, Algeria'}
              </div>
              <p class="text-xs sm:text-sm text-text-muted max-w-2xl leading-relaxed pt-1">
                {locale === 'ar'
                  ? 'برنامج هندسة الدولة الجزائري الصارم لمدة 5 سنوات، يجمع بين الدراسات التحضيرية المندمجة، التعقيد الخوارزمي، وتعلّم الآلة الإحصائي، وهندسة قواعد البيانات والأنظمة الموزعة للإنتاج.'
                  : 'Rigorous 5-year Algerian state engineering curriculum (Diplôme d\'Ingénieur d\'État) combining integrated preparatory engineering studies, advanced algorithmic complexity, statistical machine learning, database internals, and distributed systems architecture.'}
              </p>
            </div>
          </div>

          <div class="flex flex-col items-start md:items-end gap-2 shrink-0 font-mono text-xs">
            <span class="px-3 py-1 rounded-full bg-surface-2 border border-border text-text font-medium">
              {locale === 'ar' ? 'طالب هندسة دولة' : 'Engineering Student (Ingénieur d\'État)'}
            </span>
            <span class="text-text-faint text-[11px]">{locale === 'ar' ? 'برنامج وطني 5 سنوات' : '5-Year State Program'}</span>
          </div>
        </div>
      </div>
    </Reveal>
  </div>
</section>

<script>
  function setupExperienceToggle() {
    const btn = document.getElementById('toggle-experience-btn');
    const extra = document.getElementById('extra-experience-section');
    if (!btn || !extra) return;

    btn.addEventListener('click', () => {
      const isHidden = extra.classList.contains('hidden');
      if (isHidden) {
        extra.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
        const textSpan = btn.querySelector('.exp-text');
        const iconSpan = btn.querySelector('.exp-icon');
        if (textSpan) textSpan.textContent = btn.dataset.showLess || 'Show less experience';
        if (iconSpan) iconSpan.textContent = '↑';
      } else {
        extra.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        const textSpan = btn.querySelector('.exp-text');
        const iconSpan = btn.querySelector('.exp-icon');
        if (textSpan) textSpan.textContent = btn.dataset.showMore || 'See more experience';
        if (iconSpan) iconSpan.textContent = '↓';
        btn.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
  }

  setupExperienceToggle();
  document.addEventListener('astro:page-load', setupExperienceToggle);
</script>
