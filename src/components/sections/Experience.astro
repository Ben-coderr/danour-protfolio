---
import { getTimeline } from '../../i18n/experience.ar';
import type { Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const {
  locale = (Astro.currentLocale as Locale) || (Astro.url.pathname.startsWith('/ar') ? 'ar' : 'en'),
} = Astro.props;

const timeline = getTimeline(locale);
---

<section id="experience" class="py-20 md:py-28 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 md:px-12 space-y-16">
    <!-- Header -->
    <div class="space-y-3 pb-4">
      <h2 class="text-headline text-text">
        {locale === 'ar' ? 'المسار الزمني والأدوار الهندسية' : 'Engineering Timeline & Roles'}
      </h2>
      <p class="text-body text-text-muted max-prose">
        {
          locale === 'ar'
            ? 'سجل من الأدوار الهندسية والقيادية في بناء المنتجات، تدريس الذكاء الاصطناعي، وتوجيه المطورين عبر مختلف المنصات.'
            : 'A continuous track record of engineering leadership, production application delivery, and developer education.'
        }
      </p>
    </div>

    <!-- Editorial Timeline -->
    <div class="space-y-12">
      {
        timeline.map((item) => (
          <article class="bg-surface rounded-lg p-6 sm:p-8 lg:p-10 space-y-5" data-reveal>
            <div class="space-y-1">
              <h3 class="text-2xl font-bold text-text tracking-tight">
                {item.role}
              </h3>
              <div class="text-body font-semibold text-text-muted">
                {item.company}
              </div>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-3 text-small text-text-muted">
              <div class="flex items-center gap-2.5">
                <span class="text-text font-bold">{item.period}</span>
                <span>·</span>
                <span>{item.category}</span>
                <span>·</span>
                <span>{item.location}</span>
              </div>
              {item.status === 'active' && (
                <div class="flex items-center gap-2 text-status font-semibold">
                  <span class="w-2 h-2 rounded-full bg-status"></span>
                  <span>{locale === 'ar' ? 'دور حالي ونشط' : 'Active Role'}</span>
                </div>
              )}
            </div>

            <p class="text-body text-text-muted leading-relaxed max-prose">
              {item.summary}
            </p>

            {item.achievements && item.achievements.length > 0 && (
              <ul class="space-y-2 pt-2 text-body text-text-muted max-prose list-disc pl-4 rtl:pl-0 rtl:pr-4">
                {item.achievements.map((h: string) => (
                  <li class="leading-relaxed">{h}</li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
