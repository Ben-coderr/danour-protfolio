---
import Button from '../ui/Button.astro';
import { useTranslations, type Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const {
  locale = (Astro.currentLocale as Locale) || (Astro.url.pathname.startsWith('/ar') ? 'ar' : 'en'),
} = Astro.props;

const t = useTranslations(locale);
const homeUrl = locale === 'ar' ? '/ar' : '/';
const workUrl = locale === 'ar' ? '/ar/work' : '/work';
---

<section class="relative pt-10 pb-20 md:pt-16 md:pb-28 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 md:px-12">
    <!-- Monumental Wordmark Backdrop (Subtle Architecture) -->
    <div
      class="text-monument text-text select-none opacity-[0.04] pointer-events-none tracking-tighter overflow-hidden leading-none mb-4"
      aria-hidden="true"
    >
      BENCODER
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-center">
      <!-- Main Content Column -->
      <div class="lg:col-span-7 space-y-7" data-reveal>
        <div class="space-y-4">
          {
            locale === 'ar' ? (
              <h1 class="text-display text-text">
                أنظمة الذكاء الاصطناعي والمعماريات
              </h1>
            ) : (
              <h1 class="text-display text-text">
                AI Systems & Architecture
              </h1>
            )
          }

          <p class="text-lead text-text-muted max-prose">
            {
              locale === 'ar'
                ? 'مدرب الذكاء الاصطناعي في Everest Academy ومهندس برمجيات متكامل بالجزائر، أربط بين أبحاث نماذج اللغة والذكاء الاصطناعي التطبيقية والمعماريات البرمجية الإنتاجية.'
                : 'Lead AI Instructor at Everest Academy and full-stack software engineer based in Algeria, bridging applied artificial intelligence research with scalable production architectures.'
            }
          </p>
        </div>

        <!-- Primary Action on First Screen -->
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <Button href={workUrl} variant="primary" size="lg">
            {locale === 'ar' ? 'استعراض الأعمال الهندسية' : 'Explore Selected Work'}
          </Button>

          <Button href={`${homeUrl}#contact`} variant="secondary" size="lg">
            {t('hero.cta.contact')}
          </Button>
        </div>

        <!-- Live Signal / Availability note -->
        <div class="flex items-center gap-2.5 pt-2 text-small text-text-muted">
          <span class="w-2 h-2 rounded-full bg-status shrink-0" aria-hidden="true"></span>
          <span>
            {
              locale === 'ar'
                ? 'متاح للتدريس والاستشارات الهندسية والمشاريع المتقدمة'
                : 'Available for AI instruction, consulting, and engineering ventures'
            }
          </span>
        </div>
      </div>

      <!-- Real Video Atmosphere & Visual Anchor -->
      <div class="lg:col-span-5" data-reveal>
        <div class="relative rounded-lg overflow-hidden bg-surface aspect-4/3 sm:aspect-16/10 lg:aspect-4/3">
          <video
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster="/brand/mediterranean-night-poster.jpg"
            class="w-full h-full object-cover"
            aria-hidden="true"
          >
            <source src="/brand/mediterranean-night.webm" type="video/webm" />
          </video>
          <div class="absolute inset-0 bg-black/25 pointer-events-none" aria-hidden="true"></div>
          <div class="absolute bottom-3 start-3 end-3 flex items-center justify-between text-small text-white/90 bg-black/60 px-3 py-1.5 rounded">
            <span>{locale === 'ar' ? 'مستغانم · الجزائر (UTC+1)' : 'Mostaganem · Algeria (UTC+1)'}</span>
            <span class="text-white/70">{locale === 'ar' ? 'بث ليلي متوسطي' : 'Mediterranean Orbit'}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
