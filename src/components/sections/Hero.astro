---
import { siteConfig } from '../../data/site';
import StatusPill from '../ui/StatusPill.astro';
import Button from '../ui/Button.astro';
import Reveal from '../ui/Reveal.astro';
import { HeroConsole } from '../islands/HeroConsole';
import { useTranslations, type Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const {
  locale = (Astro.currentLocale as Locale) || (Astro.url.pathname.startsWith('/ar') ? 'ar' : 'en'),
} = Astro.props;

const t = useTranslations(locale);
const homeUrl = locale === 'ar' ? '/ar' : '/';
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden overflow-x-clip bg-dot-grid">
  <!-- Subtle ambient glow -->
  <div
    class="pointer-events-none absolute -top-40 right-0 w-[500px] h-[500px] bg-status/5 rounded-full blur-3xl select-none z-0"
    aria-hidden="true"
  ></div>

  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-span-7 space-y-6 sm:space-y-8">
        <Reveal delay={0}>
          <StatusPill avatar="/brand/avatar.jpg" text={t('hero.badge')} class="min-w-0" />
        </Reveal>

        <Reveal delay={100}>
          {
            locale === 'ar' ? (
              <h1 class="text-display text-text">
                أبني بأنظمة الذكاء الاصطناعي،{' '}
                <span class="hero-accent-text">أعلّمها</span>،{' '}
                وأشحن المنتجات الرقمية حولها.
              </h1>
            ) : (
              <h1 class="text-display text-text">
                I build with AI,{' '}
                <span class="hero-accent-text">teach it</span>,{' '}
                and ship the products around it.
              </h1>
            )
          }
        </Reveal>

        <Reveal delay={200}>
          <p class="text-base sm:text-lg text-text-muted max-w-2xl leading-relaxed">
            {
              locale === 'ar' ? (
                <>
                  أنا <strong class="text-text font-semibold">{siteConfig.name}</strong>: مهندس
                  برمجيات متكامل ومدرب ذكاء اصطناعي ومؤسس منصة{' '}
                  <strong class="text-text font-semibold bidi-tech">{siteConfig.brandName}</strong>{' '}
                  (مجتمع يضم أكثر من <span class="bidi-tech">102,000</span> مطوّر). كبير مدربي
                  الذكاء الاصطناعي في{' '}
                  <strong class="text-text font-semibold">Everest Academy</strong>، ومؤلف دورة
                  بايثون العربية على <strong class="text-text font-semibold">Udemy</strong> بتقييم{' '}
                  <span class="bidi-tech">4.8★</span> (<span class="bidi-tech">300+</span> طالب)،
                  والمهندس المعماري لمنصة{' '}
                  <strong class="text-text font-semibold bidi-tech">JG SupplyNet</strong> الرقمية.
                </>
              ) : (
                <>
                  I'm <strong class="text-text font-semibold">{siteConfig.name}</strong>: AI
                  instructor, full-stack engineer and creator behind{' '}
                  <strong class="text-text font-semibold">{siteConfig.brandName}</strong> (102K+
                  community). Lead AI instructor at{' '}
                  <strong class="text-text font-semibold">Everest Academy</strong>, author of a 4.8★
                  Arabic Python course on Udemy (300+ students), and full-stack architect behind
                  platforms like <strong class="text-text font-semibold">JG SupplyNet</strong>.
                </>
              )
            }
          </p>
        </Reveal>

        <Reveal delay={300}>
          <div class="flex flex-wrap items-center gap-4 pt-2">
            <Button href={`${homeUrl}#work`} variant="primary" size="lg">
              {t('hero.cta.work')}
            </Button>
            <Button href={`${homeUrl}#contact`} variant="secondary" size="lg">
              {t('hero.cta.contact')}
            </Button>
            <a
              href="/Abdenour_Benkorich_CV.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-mono text-text-muted hover:text-text transition-colors py-2 px-3 underline-offset-4 hover:underline"
            >
              {t('nav.downloadCv')}
            </a>
          </div>
        </Reveal>
      </div>

      <!-- Right Column: Interactive 4-Pillar Console -->
      <div class="lg:col-span-5">
        <Reveal delay={250}>
          <HeroConsole client:load />
        </Reveal>
      </div>
    </div>
  </div>
</section>
