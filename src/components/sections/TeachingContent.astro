---
import Button from '../ui/Button.astro';
import { CurriculumAccordion } from '../islands/CurriculumAccordion';
import { useTranslations, type Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const {
  locale = (Astro.currentLocale as Locale) || (Astro.url.pathname.startsWith('/ar') ? 'ar' : 'en'),
} = Astro.props;

const t = useTranslations(locale);
const basePrefix = locale === 'ar' ? '/ar' : '';
---

<section id="teaching" class="py-20 md:py-28 bg-surface-2 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 md:px-12 space-y-16">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-4">
      <div class="space-y-3">
        <h2 class="text-headline text-text">
          {locale === 'ar' ? 'تعليم الذكاء الاصطناعي وبناء المجتمع التقني' : 'AI Pedagogy & Community Engineering'}
        </h2>
        <p class="text-body text-text-muted max-prose">
          {
            locale === 'ar'
              ? 'تدريب جيل جديد من المهندسين من خلال مناهج عملية مكثفة، دورات مسجلة رصينة، ومحتوى تقني متخصص يصل لأكثر من 102,000 مطور عربي.'
              : 'Mentoring engineers through intensive practical bootcamps, structured online courses, and Arabic video tutorials reaching over 102,000 developers.'
          }
        </p>
      </div>

      <Button href={`${basePrefix}/teaching`} variant="secondary" size="md">
        {t('section.02.portal')}
      </Button>
    </div>

    <!-- Main Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      <!-- Left 7 cols: Interactive Syllabus Accordion -->
      <div class="lg:col-span-7 space-y-8" data-reveal>
        <div class="bg-surface rounded-lg p-6 sm:p-8 space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <h3 class="text-2xl font-bold text-text tracking-tight">
                "Build with AI" — One-Month Intensive
              </h3>
              <div class="text-small text-text-muted font-medium mt-1">Everest Academy Flagship</div>
            </div>
            <span class="text-small px-3 py-1 rounded bg-surface-2 text-status font-semibold">
              {locale === 'ar' ? 'الدفعة الحالية' : 'Active Cohort'}
            </span>
          </div>

          <p class="text-body text-text-muted leading-relaxed max-prose">
            {
              locale === 'ar'
                ? 'برنامج تدريبي مكثف يقوده عبد النور بن قريش في معهد Everest Academy، ينتقل بالطلاب من هندسة السياق وموجهات الذكاء الاصطناعي المتقدمة إلى شحن تطبيقات برمجية وتوليد أصول مرئية احترافية.'
                : 'An intensive, hands-on bootcamp taking engineers from prompt context architecture and AI coding to production full-stack deployment and generative motion synthesis.'
            }
          </p>
        </div>

        <CurriculumAccordion client:visible />
      </div>

      <!-- Right 5 cols: Media Platforms (BenCoder & Udemy) -->
      <div class="lg:col-span-5 space-y-8">
        <!-- Card 1: BenCoder 102K Community -->
        <article class="bg-surface rounded-lg p-6 sm:p-8 space-y-4" data-reveal>
          <div class="rounded-lg overflow-hidden bg-surface-2 aspect-16/9">
            <img
              src="/brand/bencoder-instagram.jpg"
              alt="BenCoder Community Platform"
              class="w-full h-full object-cover"
              loading="lazy"
              width="600"
              height="340"
            />
          </div>

          <div class="space-y-2 pt-1">
            <h4 class="text-xl font-bold text-text">BenCoder Platform (est. 2022)</h4>
            <div class="flex items-center justify-between text-small text-text-muted">
              <span class="font-semibold text-text">Instagram & Video Platform</span>
              <span>102,000+ Followers</span>
            </div>
            <p class="text-body text-text-muted leading-relaxed">
              {
                locale === 'ar'
                  ? 'أكثر من 45 دليلاً وشرحاً تقنياً معمقاً باللغة العربية يغطي معماريات Next.js وتطبيقات LLMs وأنظمة بايثون الخلفية.'
                  : 'Over 45 in-depth technical breakdowns and practical video guides in Arabic covering modern AI tooling, Next.js, and backend engineering.'
              }
            </p>
          </div>

          <div class="pt-2">
            <Button href="https://instagram.com/ben.coderr" variant="secondary" size="sm" target="_blank" rel="noopener noreferrer">
              {locale === 'ar' ? 'متابعة المنصة (@ben.coderr)' : 'Join Community (@ben.coderr)'}
            </Button>
          </div>
        </article>

        <!-- Card 2: Udemy Course -->
        <article class="bg-surface rounded-lg p-6 sm:p-8 space-y-4" data-reveal>
          <div class="rounded-lg overflow-hidden bg-surface-2 aspect-16/9">
            <img
              src="/brand/udemy-python.jpg"
              alt="Udemy Python Course"
              class="w-full h-full object-cover"
              loading="lazy"
              width="600"
              height="340"
            />
          </div>

          <div class="space-y-2 pt-1">
            <h4 class="text-xl font-bold text-text">Python for Beginners in Arabic</h4>
            <div class="flex items-center justify-between text-small text-text-muted">
              <span class="font-semibold text-text">Udemy Online Academy</span>
              <span>300+ Students · 4.8 Rating</span>
            </div>
            <p class="text-body text-text-muted leading-relaxed">
              {
                locale === 'ar'
                  ? 'مساق تعليمي متكامل لتعلم التفكير الخوارزمي وهياكل البيانات وبناء البرمجيات بلغة بايثون بأسلوب تطبيقي مباشر.'
                  : 'Comprehensive foundational coursework covering algorithmic problem solving, clean data structures, and object-oriented programming.'
              }
            </p>
          </div>

          <div class="pt-2">
            <Button href="https://www.udemy.com/course/bencoderr-python-course-arabic/" variant="secondary" size="sm" target="_blank" rel="noopener noreferrer">
              {locale === 'ar' ? 'عرض الدورة على Udemy' : 'View Course on Udemy'}
            </Button>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>
