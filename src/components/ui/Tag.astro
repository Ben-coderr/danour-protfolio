---
import clsx from 'clsx';
import { Icon } from 'astro-icon/components';
import { getTechIcon } from '../../lib/icons';

interface Props {
  text?: string;
  icon?: string;
  showIcon?: boolean;
  size?: 'sm' | 'md';
  class?: string;
}

const { text, icon: explicitIcon, showIcon = true, size = 'sm', class: className } = Astro.props;

const iconName = explicitIcon || (text && showIcon ? getTechIcon(text) : undefined);

const sizeStyles = {
  sm: 'text-small px-2.5 py-1 rounded gap-1.5',
  md: 'text-small px-3 py-1.5 rounded gap-2',
};

const iconSizes = {
  sm: 'w-3.5 h-3.5',
  md: 'w-4 h-4',
};
---

<span
  class={clsx(
    'inline-flex items-center bg-surface-2 text-text font-medium transition-colors duration-150 select-none shrink-0',
    sizeStyles[size],
    className
  )}
>
  {
    iconName && (
      <Icon
        name={iconName}
        is:inline
        class={clsx(iconSizes[size], 'shrink-0 text-text-muted')}
        aria-hidden="true"
      />
    )
  }
  <span>{text ? text : <slot />}</span>
</span>
