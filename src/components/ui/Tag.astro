---
import clsx from 'clsx';
import { Icon } from 'astro-icon/components';
import { getTechIcon } from '../../lib/icons';

interface Props {
  text?: string;
  icon?: string;
  showIcon?: boolean;
  size?: 'sm' | 'md';
  class?: string;
}

const {
  text,
  icon: explicitIcon,
  showIcon = true,
  size = 'sm',
  class: className,
} = Astro.props;

const iconName = explicitIcon || (text && showIcon ? getTechIcon(text) : undefined);

const sizeStyles = {
  sm: 'text-[11px] px-2.5 py-1 rounded-md gap-1.5',
  md: 'text-xs px-3 py-1.5 rounded-md gap-2',
};

const iconSizes = {
  sm: 'w-3 h-3',
  md: 'w-3.5 h-3.5',
};
---

<span
  class={clsx(
    'inline-flex items-center font-mono border border-border bg-surface text-text-muted hover:text-text hover:border-border-strong transition-colors duration-150 select-none shrink-0',
    sizeStyles[size],
    className
  )}
>
  {iconName && (
    <Icon name={iconName} is:inline class={clsx(iconSizes[size], 'shrink-0 text-text-muted group-hover:text-text')} aria-hidden="true" />
  )}
  <span>{text ? text : <slot />}</span>
</span>
