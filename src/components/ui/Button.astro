---
import type { HTMLAttributes } from 'astro/types';
import clsx from 'clsx';
import { twMerge } from 'tailwind-merge';

type ButtonVariant = 'primary' | 'secondary' | 'ghost' | 'link';
type ButtonSize = 'sm' | 'md' | 'lg';

interface BaseProps {
  variant?: ButtonVariant;
  size?: ButtonSize;
  class?: string;
  target?: string;
  rel?: string;
}

type Props = BaseProps &
  (({ href: string } & HTMLAttributes<'a'>) | ({ href?: never } & HTMLAttributes<'button'>));

const { variant = 'primary', size = 'md', class: className, href, ...rest } = Astro.props;

const baseStyles =
  'inline-flex items-center justify-center font-medium transition-colors duration-150 cursor-pointer focus-visible:outline-2 focus-visible:outline-text focus-visible:outline-offset-2 disabled:opacity-50 disabled:cursor-not-allowed select-none rounded-md';

const variantStyles: Record<ButtonVariant, string> = {
  primary: 'btn-primary hover:opacity-90 active:scale-[0.98]',
  secondary: 'btn-secondary hover:bg-surface active:scale-[0.98]',
  ghost: 'btn-ghost hover:bg-surface-2 active:scale-[0.98]',
  link: 'bg-transparent text-text hover:underline p-0 underline-offset-4 border-none',
};

const sizeStyles: Record<ButtonSize, string> = {
  sm: 'h-9 px-3.5 text-small gap-1.5',
  md: 'h-10 px-4 text-small gap-2',
  lg: 'h-12 px-6 text-base gap-2.5',
};

const classes = twMerge(
  clsx(baseStyles, variantStyles[variant], variant !== 'link' && sizeStyles[size], className)
);
---

{
  href ? (
    <a href={href} class={classes} {...(rest as HTMLAttributes<'a'>)}>
      <slot />
    </a>
  ) : (
    <button class={classes} {...(rest as HTMLAttributes<'button'>)}>
      <slot />
    </button>
  )
}
