---
import type { Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
  class?: string;
}

const {
  locale = (Astro.currentLocale as Locale) || (Astro.url.pathname.startsWith('/ar') ? 'ar' : 'en'),
  class: className = '',
} = Astro.props;

const currentPath = Astro.url.pathname;
const cleanPathEn = currentPath.replace(/^\/ar(\/|$)/, '/') || '/';
const cleanPathAr = '/ar' + (cleanPathEn === '/' ? '' : cleanPathEn);

const enUrl = cleanPathEn;
const arUrl = cleanPathAr;
---

<div
  class={`inline-flex items-center rounded-md bg-surface-2 p-1 text-small select-none ${className}`}
  role="group"
  aria-label="Language selection"
>
  <a
    href={enUrl}
    class={`px-2.5 py-1 rounded text-small transition-colors duration-150 ${
      locale === 'en'
        ? 'bg-invert-bg text-invert-text font-bold'
        : 'text-text-muted hover:text-text'
    }`}
    aria-current={locale === 'en' ? 'page' : undefined}
    title="Switch to English"
  >
    EN
  </a>
  <span class="text-text-faint px-1 text-small" aria-hidden="true">/</span>
  <a
    href={arUrl}
    class={`px-2.5 py-1 rounded text-small transition-colors duration-150 ${
      locale === 'ar'
        ? 'bg-invert-bg text-invert-text font-bold'
        : 'text-text-muted hover:text-text'
    }`}
    aria-current={locale === 'ar' ? 'page' : undefined}
    title="التبديل إلى العربية"
    lang="ar"
  >
    العربية
  </a>
</div>
