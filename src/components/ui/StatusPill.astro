---
import clsx from 'clsx';

interface Props {
  text?: string;
  avatar?: string;
  class?: string;
}

const {
  text = 'Open to AI teaching, freelance & internships',
  avatar,
  class: className,
} = Astro.props;
---

<div
  class={clsx(
    'inline-flex items-center gap-2.5 py-1 rounded-full border border-border bg-surface/90 backdrop-blur-sm text-xs font-mono tracking-wide text-text-muted shadow-2xs transition-colors hover:border-border-strong max-w-full min-w-0 select-none',
    avatar ? 'pl-1 pr-3.5' : 'px-3.5',
    className
  )}
>
  {avatar && (
    <div class="relative w-6 h-6 rounded-full overflow-hidden border border-border/80 bg-surface-2 shrink-0">
      <img
        src={avatar}
        alt="Abdenour Benkorich"
        class="w-full h-full object-cover"
        width="24"
        height="24"
        loading="eager"
      />
    </div>
  )}
  <span class="relative flex h-2 w-2 shrink-0" aria-hidden="true">
    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-status opacity-75"></span>
    <span class="relative inline-flex rounded-full h-2 w-2 bg-status"></span>
  </span>
  <span class="truncate min-w-0 leading-none">{text}</span>
</div>
