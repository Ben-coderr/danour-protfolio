---
import clsx from 'clsx';

interface Props {
  text?: string;
  avatar?: string;
  class?: string;
}

const { text = 'Available for AI teaching & engineering', avatar, class: className } = Astro.props;
---

<div
  class={clsx(
    'inline-flex items-center gap-2.5 py-1 px-3 rounded-full bg-surface-2 text-small text-text select-none',
    avatar ? 'ps-1 pe-3.5' : 'px-3.5',
    className
  )}
>
  {
    avatar && (
      <div class="relative w-6 h-6 rounded-full overflow-hidden bg-surface shrink-0">
        <img
          src={avatar}
          alt="Abdenour Benkorich"
          class="w-full h-full object-cover"
          width="24"
          height="24"
          loading="eager"
        />
      </div>
    )
  }
  <span class="w-2 h-2 rounded-full bg-status shrink-0" aria-hidden="true"></span>
  <span class="truncate min-w-0 leading-none">{text}</span>
</div>
