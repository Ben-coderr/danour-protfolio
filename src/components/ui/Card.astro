---
import type { HTMLAttributes } from 'astro/types';
import clsx from 'clsx';

interface BaseProps {
  interactive?: boolean;
  class?: string;
  padding?: 'none' | 'sm' | 'md' | 'lg';
}

type Props = BaseProps &
  (({ href: string } & HTMLAttributes<'a'>) | ({ href?: never } & HTMLAttributes<'div'>));

const { interactive = false, padding = 'md', class: className, href, ...rest } = Astro.props;

const paddingStyles = {
  none: '',
  sm: 'p-4 sm:p-5',
  md: 'p-6 sm:p-7',
  lg: 'p-8 sm:p-10',
};

const baseClasses = clsx(
  'relative rounded-lg bg-surface text-text overflow-hidden',
  interactive && 'transition-colors duration-150 hover:bg-surface-2 cursor-pointer',
  paddingStyles[padding],
  className
);
---

{
  href ? (
    <a href={href} class={baseClasses} {...(rest as HTMLAttributes<'a'>)}>
      <slot />
    </a>
  ) : (
    <div class={baseClasses} {...(rest as HTMLAttributes<'div'>)}>
      <slot />
    </div>
  )
}
