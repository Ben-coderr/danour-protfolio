---
import '../styles/global.css';
import Seo from '../components/ui/Seo.astro';
import Header from '../components/sections/Header.astro';
import Footer from '../components/sections/Footer.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  showHeader?: boolean;
  showFooter?: boolean;
  locale?: Locale;
}

const {
  title,
  description,
  ogImage,
  canonicalUrl,
  showHeader = true,
  showFooter = true,
  locale = (Astro.currentLocale as Locale) || (Astro.url.pathname.startsWith('/ar') ? 'ar' : 'en'),
} = Astro.props;

const dir = locale === 'ar' ? 'rtl' : 'ltr';
---

<!doctype html>
<html lang={locale} dir={dir} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Seo
      title={title}
      description={description}
      ogImage={ogImage}
      canonicalUrl={canonicalUrl}
      locale={locale}
    />

    <!-- Theme Blocking Script for Zero FOUC -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;

          let theme = 'dark';
          if (stored === 'light' || stored === 'dark') {
            theme = stored;
          } else if (prefersLight) {
            theme = 'light';
          } else {
            theme = 'dark';
          }

          document.documentElement.setAttribute('data-theme', theme);
          document.documentElement.style.colorScheme = theme;
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body class="bg-bg text-text min-h-screen selection:bg-invert-bg selection:text-invert-text flex flex-col antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:start-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-invert-bg focus:text-invert-text focus:rounded-md focus:shadow-lg focus:outline-none"
    >
      {locale === 'ar' ? 'الانتقال إلى المحتوى الرئيسي' : 'Skip to content'}
    </a>

    {showHeader && <Header locale={locale} />}
    <div class="flex-1 min-w-0 max-w-full overflow-x-clip">
      <slot />
    </div>
    {showFooter && <Footer locale={locale} />}
  </body>
</html>
